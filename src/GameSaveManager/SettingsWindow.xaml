<Window x:Class="GameSaveManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameSaveManager"
        Title="设置 · GameSaveVault"
        Icon="Assets/app.ico"
        Width="780" Height="660" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Panel}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- 互斥单选 chip（与 MainWindow 排序 chip 同款观感） -->
        <Style x:Key="ChipSm" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="12,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左侧导航项：单色线性图标（Segoe MDL2 Assets，Tag 承载 glyph）+ 文字 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                Height="40" Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ico" Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Width="24" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Panel2}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:CaptionBar Grid.Row="0"/>
        <Grid Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：导航 -->
            <Grid Grid.Column="0" Background="{DynamicResource Bg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="设置" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" Margin="20,16,0,8"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,10">
                        <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="SettingsNav"
                                     Tag="&#xE713;" Content="通用" IsChecked="True" Checked="OnNavCheck"/>
                        <RadioButton x:Name="NavBackup" Style="{StaticResource NavItem}" GroupName="SettingsNav"
                                     Tag="&#xE74E;" Content="备份" Checked="OnNavCheck"/>
                        <RadioButton x:Name="NavCloud" Style="{StaticResource NavItem}" GroupName="SettingsNav"
                                     Tag="&#xE753;" Content="云同步" Checked="OnNavCheck"/>
                        <RadioButton x:Name="NavData" Style="{StaticResource NavItem}" GroupName="SettingsNav"
                                     Tag="&#xE8F7;" Content="数据" Checked="OnNavCheck"/>
                        <Border Background="{DynamicResource BorderBrush}" Height="1" Margin="20,10,12,10"/>
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="SettingsNav"
                                     Tag="&#xE946;" Content="关于" Checked="OnNavCheck"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 分栏分隔线 -->
            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}"/>

            <!-- 右栏：分页内容（控件与旧版完全一致，仅按导航重新分组） -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,28,12">

                    <!-- ============ 通用 ============ -->
                    <StackPanel x:Name="PageGeneral">
                        <TextBlock Text="通用" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <CheckBox x:Name="StartupScanChk" Style="{StaticResource Switch}">
                                <StackPanel>
                                    <TextBlock Text="启动时自动扫描 Steam 库" FontSize="13"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="每次打开软件时增量扫描，只新增不重复" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <TextBlock Text="外观" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,12"/>
                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="主题模式" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="选择后立即生效并自动保存；「跟随系统」会在 Windows 深浅色切换时自动联动"
                                           FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton x:Name="ThemeSystemBtn" Style="{StaticResource ChipSm}" Content="跟随系统"
                                                 GroupName="ThemeMode" Tag="system" Checked="OnThemeModeChanged"/>
                                    <RadioButton x:Name="ThemeLightBtn" Style="{StaticResource ChipSm}" Content="清新浅色"
                                                 GroupName="ThemeMode" Tag="light" Checked="OnThemeModeChanged"/>
                                    <RadioButton x:Name="ThemeLightSoftBtn" Style="{StaticResource ChipSm}" Content="素雅浅色"
                                                 GroupName="ThemeMode" Tag="lightsoft" Checked="OnThemeModeChanged"/>
                                    <RadioButton x:Name="ThemeDarkBtn" Style="{StaticResource ChipSm}" Content="深色"
                                                 GroupName="ThemeMode" Tag="dark" Checked="OnThemeModeChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="玩家" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,12"/>
                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="默认玩家名称" FontSize="13"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="新加入游戏时，默认第一位玩家的名字；第一次备份后正式创建这位玩家"
                                               FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBox x:Name="DefaultPlayerNameBox" Grid.Column="1" Width="140" Height="30"
                                         VerticalContentAlignment="Center" FontSize="13"
                                         Background="{DynamicResource Panel2}" Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ============ 备份 ============ -->
                    <StackPanel x:Name="PageBackup" Visibility="Collapsed">
                        <TextBlock Text="备份" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,12">
            <StackPanel>
                <!-- 备份目录 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="备份存放目录" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="留空使用默认位置；更改后新备份存入新目录，已有备份仍在原位置、可正常还原"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource BtnSm}" Content="浏览…" Click="OnBrowseBackupDir"/>
                        <Button Style="{StaticResource BtnSm}" Content="恢复默认" Click="OnResetBackupDir" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBox x:Name="BackupDirBox" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                             Height="30" Margin="0,8,0,0" IsReadOnly="True"
                             VerticalContentAlignment="Center" FontSize="12" FontFamily="Consolas"
                             Background="{DynamicResource Panel2}" Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,12"/>

                <!-- 保留份数 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="每游戏最多保留份数" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="超出后自动删除最旧的备份（增量链不会被破坏）"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="MaxKeepBox" Grid.Column="1" Width="64" Height="30"
                             VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13"
                             Background="{DynamicResource Panel2}" Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,12"/>

                <!-- 增量备份 -->
                <CheckBox x:Name="IncrChk" Style="{StaticResource Switch}"
                          Checked="OnIncrToggled" Unchecked="OnIncrToggled">
                    <StackPanel>
                        <TextBlock Text="启用增量备份" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="与上次备份对比，只打包有变化的文件，大幅节省空间"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </CheckBox>

                <!-- 全量周期 -->
                <Grid Margin="0,12,0,0" x:Name="FullEveryRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="每 N 次增量后自动做一次全量" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="防止增量链过长，全量是链的起点"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="FullEveryBox" Grid.Column="1" Width="64" Height="30"
                             VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13"
                             Background="{DynamicResource Panel2}" Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,12"/>

                <!-- 运行中定时快照间隔（开关在每个游戏详情页，间隔为全局） -->
                <Grid x:Name="HotMinutesRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="运行中快照间隔（分钟，5–120）" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="在每个游戏详情页开启「运行中定时快照」后，运行期间按此间隔自动备份"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="HotMinutesBox" Grid.Column="1" Width="64" Height="30"
                             VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13"
                             Background="{DynamicResource Panel2}" Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>

                <Separator Background="{DynamicResource BorderBrush}" Margin="0,12"/>

                <!-- 全局热备份快捷键 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="全局热备份快捷键" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="游戏中按下即静默备份，无需切出窗口；点击输入框后直接按下新组合键（须含 Ctrl/Alt/Shift/Win），Backspace 清除即禁用"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBox x:Name="HotKeyBox" Width="130" Height="30" IsReadOnly="True"
                                 VerticalContentAlignment="Center" TextAlignment="Center" FontSize="13"
                                 Background="{DynamicResource Panel2}" Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 GotFocus="OnHotKeyGotFocus" LostFocus="OnHotKeyLostFocus"
                                 PreviewKeyDown="OnHotKeyPreviewKeyDown">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Button x:Name="HotKeyClearBtn" Style="{StaticResource BtnSm}" Content="清除"
                                Margin="8,0,0,0" Click="OnHotKeyClear"/>
                        <Button Style="{StaticResource BtnSm}" Content="默认"
                                Margin="8,0,0,0" Click="OnHotKeyDefault"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>
                    </StackPanel>

                    <!-- ============ 云同步 ============ -->
                    <StackPanel x:Name="PageCloud" Visibility="Collapsed">
                        <TextBlock Text="云同步" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                        <TextBlock Text="配置好 WebDAV 服务器后，在游戏详情里打开「自动云存档」的游戏会自动上传新备份，并在启动时自动收集云端备份；也可用下方按钮手动上传或查看。云端只增不覆盖、不双向删除，是异地保险副本。"
                                   FontSize="11.5" TextWrapping="Wrap" Margin="2,0,0,14"
                                   Foreground="{DynamicResource TextSecondary}" LineHeight="18"/>
        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,12">
            <StackPanel>
                <TextBlock Text="服务器地址" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,4"/>
                <TextBox x:Name="CloudUrlBox" Height="30" FontSize="12" FontFamily="Consolas"
                         VerticalContentAlignment="Center"
                         TextChanged="OnCloudUrlChanged"
                         Background="{DynamicResource Panel2}" Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock x:Name="HttpWarnText" Visibility="Collapsed" FontSize="11.5" TextWrapping="Wrap"
                           Margin="2,6,0,0" Foreground="#E0A030"
                           Text="⚠ 当前为 HTTP 明文地址：账号、应用密码与备份内容在网络中均不加密，仅建议在本机/受信任的内网使用，公网请改用 HTTPS。"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="账号" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,4"/>
                        <TextBox x:Name="CloudUserBox" Height="30" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource Panel2}" Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="应用密码" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,4"/>
                        <PasswordBox x:Name="CloudPassBox" Height="30" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource Panel2}" Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <PasswordBox.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </PasswordBox.Resources>
                        </PasswordBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="云端目录" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="2,10,0,4"/>
                <TextBox x:Name="CloudDirBox" Height="30" FontSize="12"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource Panel2}" Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="删除备份时" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" Margin="2,10,0,4"/>
                <CheckBox x:Name="CloudDelWithCloudChk" Style="{StaticResource Switch}"
                          Content="同时删除云端副本"
                          ToolTip="删除有云端副本的备份时弹对话框，此勾选状态作为默认值；每次操作后沿用，但每次都会询问"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="CloudTestBtn" Style="{StaticResource BtnSm}" Content="☁ 测试连接" Click="OnCloudTest"/>
                    <Button x:Name="CloudUploadBtn" Style="{StaticResource BtnSm}" Content="☁ 立即上传全部"
                            Click="OnCloudUploadAll" Margin="8,0,0,0"/>
                    <Button x:Name="CloudBrowseBtn" Style="{StaticResource BtnSm}" Content="☁ 查看云端备份…"
                            Click="OnCloudBrowse" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="CloudStatusText" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}" Margin="2,8,0,0"/>
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="支持坚果云、Nextcloud、群晖/威联通 NAS、AList 等任何 WebDAV 服务。坚果云需在账号安全设置中生成「应用密码」，不要填登录密码；免费版有月度流量限制。"/>
            </StackPanel>
        </Border>
                    </StackPanel>

                    <!-- ============ 数据 ============ -->
                    <StackPanel x:Name="PageData" Visibility="Collapsed">
                        <TextBlock Text="数据" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>
        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="数据目录" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="{Binding DataDir, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                           FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Style="{StaticResource BtnSm}" Content="打开"
                        Click="OnOpenDataDir" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <TextBlock Text="游戏库 games.json · 备份 backups\ · 图标封面缓存 cache\" FontSize="11"
                   Foreground="{DynamicResource TextSecondary}" Margin="4,8,0,0" TextWrapping="Wrap"/>

        <!-- 中文名数据源 -->
        <TextBlock Text="中文名数据源" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,12"/>
        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,12">
            <StackPanel>
                <TextBlock Text="自动模式按顺序依次尝试；单个网站故障会自动跳过（连续失败 2 次本次运行不再访问）。已获取的中文名存入本地库，断网也可用。"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ListBox x:Name="SourceList" MaxHeight="160" Background="{DynamicResource Panel2}"
                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                           Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource BuiltInTagBg}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                        Visibility="{Binding BuiltIn, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="内置" FontSize="10" Foreground="{DynamicResource BuiltInTagText}"/>
                                </Border>
                                <TextBlock Text="JSON" FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsJson, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="正则" FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsRegex, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource BtnSm}" Content="添加" Click="OnAddSource"/>
                    <Button Style="{StaticResource BtnSm}" Content="编辑" Margin="6,0,0,0" Click="OnEditSource"/>
                    <Button Style="{StaticResource BtnSm}" Content="删除" Margin="6,0,0,0" Click="OnDeleteSource"/>
                    <Button Style="{StaticResource BtnSm}" Content="上移" Margin="6,0,0,0" Click="OnMoveSourceUp"/>
                    <Button Style="{StaticResource BtnSm}" Content="下移" Margin="6,0,0,0" Click="OnMoveSourceDown"/>
                </StackPanel>
                <TextBlock Text="URL 支持占位符 {appid}；JSON 提取如 result.name，正则提取取第 1 个括号（如 &lt;meta property=&quot;og:title&quot; content=&quot;([^&quot;]+)&quot;）"
                           FontSize="10.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="2,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- AppId 搜索数据源 -->
        <TextBlock Text="AppId 搜索数据源" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,20,0,12"/>
        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,12">
            <StackPanel>
                <TextBlock Text="编辑游戏时点「查询」按游戏名搜 AppId；按顺序尝试，单个网站故障自动跳过。注：小黑盒搜索需登录，故不在此列。"
                           FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ListBox x:Name="AppIdSourceList" MaxHeight="130" Background="{DynamicResource Panel2}"
                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                           Foreground="{DynamicResource TextPrimary}" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource BuiltInTagBg}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                        Visibility="{Binding BuiltIn, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="内置" FontSize="10" Foreground="{DynamicResource BuiltInTagText}"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource BtnSm}" Content="添加" Click="OnAddAppIdSource"/>
                    <Button Style="{StaticResource BtnSm}" Content="编辑" Margin="6,0,0,0" Click="OnEditAppIdSource"/>
                    <Button Style="{StaticResource BtnSm}" Content="测试连接" Margin="6,0,0,0" Click="OnTestAppIdSource"
                            ToolTip="对选中的数据源（含内置）实际发一次搜索，检查连接是否正常"/>
                    <Button Style="{StaticResource BtnSm}" Content="删除" Margin="6,0,0,0" Click="OnDeleteAppIdSource"/>
                    <Button Style="{StaticResource BtnSm}" Content="上移" Margin="6,0,0,0" Click="OnMoveAppIdSourceUp"/>
                    <Button Style="{StaticResource BtnSm}" Content="下移" Margin="6,0,0,0" Click="OnMoveAppIdSourceDown"/>
                </StackPanel>
                <TextBlock Text="URL 占位符 {name_urlenc}；列表路径如 data.results，再指定每项的 AppId 字段(id)、名称字段(name)、封面字段(image，可空)"
                           FontSize="10.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="2,8,0,0"/>
            </StackPanel>
        </Border>
                    </StackPanel>

                    <!-- ============ 关于 ============ -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Text="关于" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
                            <Image Source="Assets/app.ico" Width="56" Height="56"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="16,4,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GameSaveVault" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="游戏存档管家" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="AboutVersionText" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="AboutBuildText" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="软件介绍" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="一款完全本地运行的游戏存档管家，帮你安心管好每一份游戏进度。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="• 自动扫描 Steam 与本地游戏，统一查看和管理存档&#x0a;• 多个玩家各自独立存档、互不影响，支持增量备份、运行中定时快照与一键还原&#x0a;• 支持 WebDAV 云盘异地副本（坚果云、群晖/威联通 NAS、Nextcloud 等）&#x0a;• 自动记录游玩时长与每次游玩记录"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextSecondary}" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="数据与隐私" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="本软件不内置账号体系，游戏库、备份和设置全部保存在你的电脑上；云同步仅在你自己配置 WebDAV 后，向你填写的服务器发送备份文件。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextSecondary}" LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 按钮（常驻底部，不随内容滚动） -->
        <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,12,24,14">
            <Grid>
                <TextBlock x:Name="ErrText" Foreground="{DynamicResource Red}" FontSize="12"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn}" Content="取消" Width="80" IsCancel="True"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="保存" Width="80"
                            Margin="10,0,0,0" Click="OnSave" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
