<Window x:Class="GameSaveManager.CloudBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameSaveManager"
        Title="云端备份 · GameSaveVault"
        Icon="Assets/app.ico"
        Width="760" Height="520" MinHeight="380" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Panel}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <local:BlankToCollapsed x:Key="BlankToCollapsed"/>
        <!-- ── 深色细滚动条：默认宽银灰条在深色页上非常突兀 ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="tb" CornerRadius="5" Background="{DynamicResource TabBg}" Margin="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Background" Value="{DynamicResource TabHoverBg}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="tb" Property="Background" Value="{DynamicResource TabActiveBg}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Height" Value="Auto"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── 深色下拉框：默认 ComboBox 是白底黑箭头，与主题冲突 ── -->
        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Padding="10,6" Margin="0,1" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource RowHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource RowSelectedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{DynamicResource Panel2}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8">
                                            <Path Data="M0,0 L4,4 8,0" Stroke="{DynamicResource TextSecondary}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 表头：扁平深色，去掉默认银灰渐变；保留 PART_HeaderGripper 以支持拖宽列 ── -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="Transparent" BorderBrush="{DynamicResource CloudBorder}"
                                    BorderThickness="0,0,0,1" Padding="12,9,8,7">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="18"
                                   Margin="0,0,-9,0" Background="Transparent">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 数据行：与主窗口游戏列表同一套状态色（RowHoverBg / RowSelectedBg）── -->
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Margin="3,1" Padding="9,7" SnapsToDevicePixels="True">
                            <!-- 多列行必须用 GridViewRowPresenter（普通 ContentPresenter 只会 ToString 整行对象） -->
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBg}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedHoverBg}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── 单元格：文件名/游戏为主文字，玩家/大小/时间为弱化色，形成信息层级 ── -->
        <DataTemplate x:Key="CGame">
            <TextBlock Text="{Binding Game}" ToolTip="{Binding Game}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="CProfile">
            <TextBlock Text="{Binding ProfileText}" Foreground="{DynamicResource TextSecondary}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ProfileText}"/>
        </DataTemplate>
        <DataTemplate x:Key="CNote">
            <!-- 备注：上传前本地有备注则显示本地备注（无则留空）；文件名移到整行鼠标浮窗 -->
            <TextBlock Text="{Binding NoteText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding NoteText}"/>
        </DataTemplate>
        <DataTemplate x:Key="CSize">
            <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextSecondary}"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="CTime">
            <!-- 主行存档时间（游戏真实保存时刻），副行小字上传时刻；无索引条目的旧包只有上传时间 -->
            <StackPanel>
                <TextBlock Text="{Binding MainTimeText}" Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding UploadTimeText}" FontSize="10"
                           Foreground="{DynamicResource TextSecondary}"
                           Visibility="{Binding UploadTimeText, Converter={StaticResource BlankToCollapsed}}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:CaptionBar Grid.Row="0"/>
        <Grid Grid.Row="1" Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="GameFilter" Grid.Column="0" Width="210" Style="{StaticResource Combo}"
                      Margin="0,0,12,0"
                      SelectionChanged="OnFilterChanged"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource TextSecondary}"
                       TextTrimming="CharacterEllipsis"
                       Text="正在读取云端文件列表…"/>
            <Button x:Name="RefreshBtn" Grid.Column="2" Style="{StaticResource BtnSm}"
                    Content="刷新" Click="OnRefresh"/>
        </Grid>

        <Border Grid.Row="1" Margin="0,10,0,0"
                Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10">
            <ListView x:Name="FileList" BorderThickness="0" Background="Transparent"
                      Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      MouseDoubleClick="OnDownload">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="游戏" Width="150" CellTemplate="{StaticResource CGame}"/>
                        <GridViewColumn Header="玩家" Width="96" CellTemplate="{StaticResource CProfile}"/>
                        <GridViewColumn Header="存档时间" Width="130" CellTemplate="{StaticResource CTime}"/>
                        <GridViewColumn Header="备注" Width="220" CellTemplate="{StaticResource CNote}"/>
                        <GridViewColumn Header="大小" Width="82" CellTemplate="{StaticResource CSize}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 自定义模板：系统默认 indeterminate 动画是亮白条，在深色窗上非常刺眼 -->
            <ProgressBar x:Name="BusyBar" Grid.Column="0" Width="240" Height="6"
                         Minimum="0" Maximum="1" Value="0" Foreground="{DynamicResource Accent2}"
                         VerticalAlignment="Center" HorizontalAlignment="Left"
                         Visibility="Collapsed">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="3" Background="{DynamicResource CloudTagBg}">
                            <Grid ClipToBounds="True">
                                <!-- 确定模式：PART_Indicator 宽度由 ProgressBar 按 Value 自动设置 -->
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        CornerRadius="3" Background="{DynamicResource Accent2}"/>
                                <!-- 不确定模式：循环滑动的短条 -->
                                <Border x:Name="IndBar" Width="90" CornerRadius="3"
                                        Background="{DynamicResource Accent2}" Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="IndMove" X="-90"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="IndBar" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="IndStory">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="IndMove"
                                                             Storyboard.TargetProperty="X"
                                                             From="-90" To="240" Duration="0:0:1.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="IndStory"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MapBtn" Style="{StaticResource Btn}" Content="未匹配"
                        Width="100" Click="OnShowUnmatched"/>
                <Button x:Name="DeleteBtn" Style="{StaticResource Btn}" Content="删除云端备份"
                        Margin="10,0,0,0" Click="OnDelete"/>
                <Button x:Name="DownloadBtn" Style="{StaticResource BtnPrimary}" Content="下载并导入"
                        Margin="10,0,0,0" Click="OnDownload"/>
                <Button Style="{StaticResource Btn}" Content="关闭" Width="80"
                        Margin="10,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</Window>
