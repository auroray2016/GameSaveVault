<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Color（供 DropShadowEffect / GradientStop 使用） ===== -->
    <Color x:Key="ShadowColor">#FF000000</Color>
    <!-- 卡片悬停柔光高光：深色主题用纯浅白半透明扫光 -->
    <Color x:Key="GlowColor">#6BFFFFFF</Color>
    <Color x:Key="GlowColorMid">#2AFFFFFF</Color>
    <Color x:Key="GlowColorFade">#00FFFFFF</Color>
    <Color x:Key="IconPlaceholderStart">#6366F1</Color>
    <Color x:Key="IconPlaceholderEnd">#A855F7</Color>
    <Color x:Key="CoverPlaceholderStart">#2A3247</Color>
    <Color x:Key="CoverPlaceholderEnd">#1A1D25</Color>

    <!-- ===== 表面层 ===== -->
    <SolidColorBrush x:Key="Bg" Color="#12141A"/>
    <SolidColorBrush x:Key="Panel" Color="#1A1D25"/>
    <SolidColorBrush x:Key="Panel2" Color="#20242E"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A2F3B"/>
    <!-- 列表行内极淡分隔线（比 BorderBrush 弱一档，仅用于行间，不用于分区边框） -->
    <SolidColorBrush x:Key="RowDivider" Color="#0BFFFFFF"/>

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E6EAF2"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#929BB0"/>
    <SolidColorBrush x:Key="MonoText" Color="#C3CAD8"/>
    <!-- Toast 深底浅字（与浅色主题同语义键，深底对比度充足） -->
    <SolidColorBrush x:Key="ToastText" Color="#E6EAF2"/>
    <SolidColorBrush x:Key="ToastErrorText" Color="#FF9488"/>

    <!-- ===== 品牌 ===== -->
    <SolidColorBrush x:Key="Accent" Color="#4F8CFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#5E97FF"/>
    <SolidColorBrush x:Key="AccentPrimary" Color="#3B6FD9"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#26364F"/>
    <SolidColorBrush x:Key="AccentSoftBorder" Color="#664F8CFF"/>
    <SolidColorBrush x:Key="AccentOnText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent2" Color="#22D3EE"/>
    <SolidColorBrush x:Key="Accent2Soft" Color="#2622D3EE"/>

    <!-- ===== 状态 ===== -->
    <SolidColorBrush x:Key="Green" Color="#34D399"/>
    <SolidColorBrush x:Key="GreenSoft" Color="#264CD964"/>
    <SolidColorBrush x:Key="GreenSoftBorder" Color="#664CD964"/>
    <SolidColorBrush x:Key="OnGreenText" Color="#0C1D36"/>
    <SolidColorBrush x:Key="Orange" Color="#FBBF24"/>
    <SolidColorBrush x:Key="GoldLock" Color="#E8B84B"/>
    <SolidColorBrush x:Key="Red" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerPrimary" Color="#C9433F"/>
    <SolidColorBrush x:Key="DangerHover" Color="#F87171"/>

    <!-- ===== 控件派生 ===== -->
    <SolidColorBrush x:Key="BtnHoverBg" Color="#253046"/>
    <SolidColorBrush x:Key="RowHoverOverlay" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="ItemSelectedBg" Color="#29000000"/>
    <SolidColorBrush x:Key="CardSelectedBg" Color="#242833"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#2E3441"/>
    <SolidColorBrush x:Key="SwitchTrackOff" Color="#333A48"/>
    <SolidColorBrush x:Key="ToggleHoverBorder" Color="#5A6578"/>
    <SolidColorBrush x:Key="StarInactive" Color="#3E4658"/>
    <SolidColorBrush x:Key="IconRing" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="OnPrimaryOverlay" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="OnPrimaryTextMuted" Color="#DCE7FF"/>
    <SolidColorBrush x:Key="KindFullBg" Color="#26929BB0"/>
    <SolidColorBrush x:Key="ToastBg" Color="#F01C202A"/>

    <!-- ===== 行状态（云端 / 孤儿备份） ===== -->
    <SolidColorBrush x:Key="RowHoverBg" Color="#15263F"/>
    <SolidColorBrush x:Key="RowSelectedBg" Color="#0C1D36"/>
    <SolidColorBrush x:Key="RowSelectedHoverBg" Color="#122035"/>

    <!-- ===== 标签页 / 云端局部 ===== -->
    <SolidColorBrush x:Key="TabBg" Color="#39415A"/>
    <SolidColorBrush x:Key="TabHoverBg" Color="#4A566E"/>
    <SolidColorBrush x:Key="TabActiveBg" Color="#5A6578"/>
    <SolidColorBrush x:Key="CloudBorder" Color="#242A37"/>
    <SolidColorBrush x:Key="CloudTagBg" Color="#262C38"/>

    <!-- ===== 徽章 ===== -->
    <SolidColorBrush x:Key="BadgeLocalBg" Color="#1EF4B12F"/>
    <SolidColorBrush x:Key="BadgeLocalBorder" Color="#4DF4B12F"/>
    <SolidColorBrush x:Key="BadgeSteamBg" Color="#2466C0F4"/>
    <SolidColorBrush x:Key="BadgeSteamBorder" Color="#4D66C0F4"/>
    <SolidColorBrush x:Key="SteamText" Color="#66C0F4"/>
    <SolidColorBrush x:Key="BuiltInTagBg" Color="#2A4F8CFF"/>
    <SolidColorBrush x:Key="BuiltInTagText" Color="#8FB4FF"/>

    <!-- ===== 沉浸式 UU 风（仅游戏详情/完结馆/完结回顾局部使用；浅色主题映射回常态色） ===== -->
    <!-- Color 与 Brush 成对定义：ImmersiveScope 用语义键覆盖子树，颜色须随主题实时切换 -->
    <!-- 深夜蓝黑底（对标 UU：近黑的深蓝，非发紫的靛蓝） -->
    <Color x:Key="UuBgTop">#10152E</Color>
    <Color x:Key="UuBgMid">#0B0F22</Color>
    <Color x:Key="UuBgBottom">#070A16</Color>
    <!-- 艺术底（模糊封面/海报）可见度：深色全开，浅色归零（浅色主题零变化） -->
    <sys:Double x:Key="UuArtOpacity">1</sys:Double>
    <!-- 艺术底压暗遮罩：海报要看得清（UU 风背景清晰），只压约 60% 深黑蓝 -->
    <Color x:Key="UuArtVeilC">#990A1020</Color>
    <Color x:Key="UuGlowTealC">#13E2C8</Color>
    <Color x:Key="UuGlowIndigoC">#4155A8</Color>
    <LinearGradientBrush x:Key="UuBackdropBrush" StartPoint="0,0" EndPoint="0.15,1">
        <GradientStop Color="{StaticResource UuBgTop}" Offset="0"/>
        <GradientStop Color="{StaticResource UuBgMid}" Offset="0.55"/>
        <GradientStop Color="{StaticResource UuBgBottom}" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="UuGlowTealBrush" Center="0.12,0.05" GradientOrigin="0.18,0.02"
                         RadiusX="0.75" RadiusY="0.6">
        <GradientStop Color="#1813E2C8" Offset="0"/>
        <GradientStop Color="#0013E2C8" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="UuGlowIndigoBrush" Center="0.92,0.7" GradientOrigin="0.9,0.72"
                         RadiusX="0.65" RadiusY="0.7">
        <GradientStop Color="#244155A8" Offset="0"/>
        <GradientStop Color="#004155A8" Offset="1"/>
    </RadialGradientBrush>
    <!-- 卡面：半透明深蓝玻璃（UU 的区域框是透底的；背景本就高斯模糊，半透=毛玻璃） -->
    <Color x:Key="UuPanelC">#8C172244</Color>
    <Color x:Key="UuPanel2C">#661E2A52</Color>
    <Color x:Key="UuInnerBgC">#B30B1022</Color>
    <!-- 玻璃卡边：20% 白细边做高光描边 -->
    <Color x:Key="UuBorderC">#33FFFFFF</Color>
    <Color x:Key="UuTextC">#EDEFF8</Color>
    <Color x:Key="UuText2C">#8D97BE</Color>
    <!-- 压暗遮罩：顶部 14% 从近黑过渡到 60%，消除横幅与艺术底的硬接缝；向下保持背景清晰。
         完结馆/完结回顾自带整层壁纸，直接使用本渐变 -->
    <LinearGradientBrush x:Key="UuArtVeil" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F50A1020" Offset="0"/>
        <GradientStop Color="{StaticResource UuArtVeilC}" Offset="0.14"/>
        <GradientStop Color="{StaticResource UuArtVeilC}" Offset="1"/>
    </LinearGradientBrush>
    <!-- 主体区（列表+详情）通铺壁纸时使用：均匀 60% 压暗，左右两侧亮度连续一致 -->
    <SolidColorBrush x:Key="UuArtVeilFlat" Color="{StaticResource UuArtVeilC}"/>
    <!-- 通铺之后的详情专用叠加层：仅在顶部补 90%→0 的重压，与 Flat 叠合后还原 UuArtVeil 的接缝过渡，
         中下部为零叠加，保证左右两侧壁纸压暗程度相同 -->
    <LinearGradientBrush x:Key="UuArtVeilTop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E60A1020" Offset="0"/>
        <GradientStop Color="#000A1020" Offset="0.16"/>
        <GradientStop Color="#000A1020" Offset="1"/>
    </LinearGradientBrush>
    <!-- 侧栏/空态底色：深色全透，让通铺壁纸直透上来与右侧连成一片（浅色主题为不透明白，零变化） -->
    <SolidColorBrush x:Key="SideBarBg" Color="#00000000"/>
    <!-- 未选游戏空态：深色同样全透（壁纸左右连续，中间玻璃卡浮于壁纸上） -->
    <SolidColorBrush x:Key="EmptyStateBg" Color="#00000000"/>
    <SolidColorBrush x:Key="UuPanel" Color="{StaticResource UuPanelC}"/>
    <SolidColorBrush x:Key="UuPanel2" Color="{StaticResource UuPanel2C}"/>
    <SolidColorBrush x:Key="UuInnerBg" Color="{StaticResource UuInnerBgC}"/>
    <SolidColorBrush x:Key="UuBorder" Color="{StaticResource UuBorderC}"/>
    <SolidColorBrush x:Key="UuText" Color="{StaticResource UuTextC}"/>
    <SolidColorBrush x:Key="UuText2" Color="{StaticResource UuText2C}"/>
    <!-- 青绿点睛 -->
    <Color x:Key="UuTealC">#13E2C8</Color>
    <Color x:Key="UuTealHiC">#54F4DF</Color>
    <Color x:Key="UuTealDeepC">#0BB9A3</Color>
    <Color x:Key="UuOnTealC">#052620</Color>
    <Color x:Key="UuTealSoftC">#2213E2C8</Color>
    <Color x:Key="UuTealSoftBorderC">#6613E2C8</Color>
    <!-- Accent2 在详情里多为前景文字：深色用亮青绿；浅色主题各自映射回原深青，保白底对比 -->
    <Color x:Key="UuAccent2C">#54F4DF</Color>
    <Color x:Key="UuAccent2SoftC">#2613E2C8</Color>
    <Color x:Key="UuTealGlowColor">#9910E0C8</Color>
    <SolidColorBrush x:Key="UuTeal" Color="{StaticResource UuTealC}"/>
    <SolidColorBrush x:Key="UuTealHi" Color="{StaticResource UuTealHiC}"/>
    <SolidColorBrush x:Key="UuTealDeep" Color="{StaticResource UuTealDeepC}"/>
    <SolidColorBrush x:Key="UuOnTeal" Color="{StaticResource UuOnTealC}"/>
    <SolidColorBrush x:Key="UuTealSoft" Color="{StaticResource UuTealSoftC}"/>
    <SolidColorBrush x:Key="UuTealSoftBorder" Color="{StaticResource UuTealSoftBorderC}"/>
    <LinearGradientBrush x:Key="UuRunBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource UuTealHiC}" Offset="0"/>
        <GradientStop Color="{StaticResource UuTealC}" Offset="0.55"/>
        <GradientStop Color="{StaticResource UuTealDeepC}" Offset="1"/>
    </LinearGradientBrush>
    <!-- 横幅上的次级「靛蓝胶囊」按钮 -->
    <Color x:Key="UuGhostBgC">#3330406E</Color>
    <Color x:Key="UuGhostBorderC">#734A568F</Color>
    <Color x:Key="UuGhostHoverBgC">#5C394882</Color>
    <Color x:Key="UuGhostHoverBorderC">#C713E2C8</Color>
    <Color x:Key="UuGhostTextC">#E9EDFA</Color>
    <SolidColorBrush x:Key="UuGhostBg" Color="{StaticResource UuGhostBgC}"/>
    <SolidColorBrush x:Key="UuGhostBorder" Color="{StaticResource UuGhostBorderC}"/>
    <SolidColorBrush x:Key="UuGhostHoverBg" Color="{StaticResource UuGhostHoverBgC}"/>
    <SolidColorBrush x:Key="UuGhostHoverBorder" Color="{StaticResource UuGhostHoverBorderC}"/>
    <SolidColorBrush x:Key="UuGhostText" Color="{StaticResource UuGhostTextC}"/>
    <!-- 控件派生 -->
    <Color x:Key="UuBtnHoverC">#2A3560</Color>
    <Color x:Key="UuRowHoverC">#1E2749</Color>
    <Color x:Key="UuScrollThumbC">#2B365E</Color>
    <Color x:Key="UuIconRingC">#66FFFFFF</Color>
    <Color x:Key="UuDividerC">#14FFFFFF</Color>
    <SolidColorBrush x:Key="UuBtnHover" Color="{StaticResource UuBtnHoverC}"/>
    <SolidColorBrush x:Key="UuRowHover" Color="{StaticResource UuRowHoverC}"/>
    <SolidColorBrush x:Key="UuScrollThumb" Color="{StaticResource UuScrollThumbC}"/>
    <SolidColorBrush x:Key="UuIconRing" Color="{StaticResource UuIconRingC}"/>
    <SolidColorBrush x:Key="UuDivider" Color="{StaticResource UuDividerC}"/>
    <!-- 沉浸区其余语义映射：选中态/主按钮叠加/完整备份签/图标占位渐变 -->
    <Color x:Key="UuRowHoverOverlayC">#12FFFFFF</Color>
    <Color x:Key="UuItemSelC">#2213E2C8</Color>
    <Color x:Key="UuCardSelC">#2213E2C8</Color>
    <Color x:Key="UuRowSelC">#2213E2C8</Color>
    <Color x:Key="UuRowSelHoverC">#2E13E2C8</Color>
    <Color x:Key="UuOnPrimaryOverlayC">#22000000</Color>
    <Color x:Key="UuOnPrimaryMutedC">#A6052620</Color>
    <Color x:Key="UuKindFullBgC">#260BB9A3</Color>

    <!-- ===== 完结回顾·纪念卡（冷调墨底 + 克制香槟金；金色只给日期主角） ===== -->
    <Color x:Key="MemorialBgTop">#1E212B</Color>
    <Color x:Key="MemorialBgBottom">#171920</Color>
    <Color x:Key="MemorialGoldHi">#EBDDAA</Color>
    <Color x:Key="MemorialGoldLo">#C4AD6B</Color>
    <SolidColorBrush x:Key="MemorialBorder" Color="#4A422C"/>
    <SolidColorBrush x:Key="MemorialTitle" Color="#A89E7E"/>
    <SolidColorBrush x:Key="MemorialMuted" Color="#868372"/>
    <SolidColorBrush x:Key="MemorialValue" Color="#DDD9C8"/>
    <SolidColorBrush x:Key="MemorialSince" Color="#D4C084"/>
    <SolidColorBrush x:Key="MemorialDivider" Color="#2E2E2A"/>

</ResourceDictionary>
