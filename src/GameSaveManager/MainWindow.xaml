<Window x:Class="GameSaveManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameSaveManager"
        xmlns:models="clr-namespace:GameSaveManager.Models"
        Title="GameSaveVault"
        Icon="Assets/app.ico"
        Width="1240" Height="800" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        DataContext="{Binding RelativeSource={RelativeSource Self}}">

    <!-- 自绘标题栏：客户区扩展进原生标题栏，三颗按钮自己画（颜色才能跟随主题、
         系统 DWM 按钮在自绘 Chrome 上深浅不可控）；CaptionHeight=32 区域可拖拽/双击最大化。
         这样壁纸能从主体区一直铺到窗口最顶端。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:BoolToVis x:Key="BoolToVis"/>
        <local:InverseBoolToVis x:Key="InverseBoolToVis"/>
        <local:BlankToCollapsed x:Key="BlankToCollapsed"/>

        <!-- 筛选 chip -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="12,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource ScrollThumb}" CornerRadius="5" Margin="2,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 类型徽章 -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,1.5"/>
            <Setter Property="Background" Value="{DynamicResource BadgeLocalBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeLocalBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Steam">
                    <Setter Property="Background" Value="{DynamicResource BadgeSteamBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BadgeSteamBorder}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 收藏星标（列表项） -->
        <Style x:Key="FavBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource StarInactive}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <!-- 固定正方：热区/悬停块即此 24x24 边界，星标在块内朴素居中，不做位移补偿 -->
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="ToolTip" Value="收藏置顶"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 朴素居中：无 Padding、无位移补偿，ContentPresenter 在 24x24 正方块内
                             水平垂直居中（与最初自适应按钮时代同一算法，仅外框固定为正方）。 -->
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Favorite}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Orange}"/>
                    <Setter Property="ToolTip" Value="取消收藏"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 搜索框清除按钮 -->
        <Style x:Key="SearchClearBtn" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="清空搜索"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource Panel2}" CornerRadius="9">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Orange}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="Steam">
                    <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 横幅徽章：封面黑遮罩是恒定暗底，浅色主题的 Orange/SteamText（为白底设计）压上去发糊。
             统一用半透明白玻璃底 + 白字，类型信息由文字本身表达，三套主题通用。 -->
        <Style x:Key="HeroBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,1.5"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="HeroBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 列表项：单张金属游戏卡片。平整带柔和投影；悬停放大上浮+投影加深；
             rotateY 倾斜感（2D 横向压缩 + 方向暗角近似）/扫光圆心跟随鼠标（代码后置实时更新），
             离开全部平滑复位。纯 2D 合成层实现，无 Viewport3D/逐卡纹理等重开销。
             扫光用绝对坐标径向渐变叠加，不依赖自定义像素着色器。 -->
        <DataTemplate x:Key="GameListItem" DataType="models:GameEntry">
            <!-- 纯 2D 合成层特效（无 Viewport3D / 无逐卡纹理，全部只动 RenderTransform/Opacity）：
                 CardRoot（行宽 × 固定行高）：接收鼠标事件；
                 ShadowHost（透明，仅投影）：DropShadow 按内层 alpha 投出，放大/倾斜时阴影即卡片轮廓；
                 LiftHost（放大 1.02 + 上浮 -3px，绕中心）：对应 CSS 的 card-lift；
                 CardFace（卡片本体）：ScaleX 横向压缩模拟 rotateY ±6°（2D 仿射做不了真透视梯形，
                   改用「远侧边缘锚定 + 近侧向内收缩 + 受压侧方向暗角」组合，肉眼同样读作 Y 轴倾斜，
                   开销只有一个 ScaleTransform），标题/图标/收藏/扫光都在里面。
                 行高固定；卡片尺寸由 Margin 自然布局得到，不需要任何代码测量/反解相机。 -->
            <!-- 阴影参数：静态几乎不可见（竖缝由卡片边框 + 缓冲 padding 提供，blur 稍大就会盖住下一张卡片上缘成黑带）。
                 悬停阴影刻意加大并垂直向下（Direction=270）：只出现在悬停期间，
                 且悬停卡片在代码后置中被提到最高 ZIndex，下方阴影盖在下一张卡片上
                 呈现自然投影，不会被邻居裁掉。 -->
            <!-- 行高 62 = 卡片本体 56（上下各 3px 间隙）与 56×56 图标齐高 -->
            <Grid x:Name="CardRoot" Height="62" Margin="1,0,1,0"
                  MouseMove="OnCardMouseMove" MouseLeave="OnCardMouseLeave">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Mouse.MouseEnter">
                        <BeginStoryboard x:Name="SbHoverBegin">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                 To="1.02" Duration="0:0:0.28"/>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                 To="1.02" Duration="0:0:0.28"/>
                                <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y"
                                                 To="-3" Duration="0:0:0.28"/>
                                <!-- 性能：BlurRadius/ShadowDepth 瞬时定终值（Duration=0），整段悬停只动画 Opacity 淡入。
                                     模糊半径逐帧变化会每帧在 CPU 上重新高斯模糊整张卡片，是悬停掉帧主因；
                                     半径恒定时模糊结果可缓存复用，视觉上只是少了几乎不可察的"扩散"感。 -->
                                <DoubleAnimation Storyboard.TargetName="CardShadow"
                                                 Storyboard.TargetProperty="(DropShadowEffect.BlurRadius)"
                                                 To="8" Duration="0:0:0"/>
                                <DoubleAnimation Storyboard.TargetName="CardShadow"
                                                 Storyboard.TargetProperty="(DropShadowEffect.ShadowDepth)"
                                                 To="5" Duration="0:0:0"/>
                                <DoubleAnimation Storyboard.TargetName="CardShadow"
                                                 Storyboard.TargetProperty="(DropShadowEffect.Opacity)"
                                                 To="0.55" Duration="0:0:0.28"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <!-- 无 MouseLeave 触发器：离开复位全部由代码后置 OnCardMouseLeave 直接对对象执行，
                         不经过名称范围解析。view.Refresh() 拆除容器时离开事件才到，此时模板名称
                         范围已销毁，任何 Storyboard.TargetName 查找都会抛异常（点收藏即触发）。 -->
                </Grid.Triggers>

                <!-- 透明阴影框：投影内容 = 内层卡片（放大/倾斜后的真实轮廓） -->
                <Border x:Name="ShadowHost" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect x:Name="CardShadow" Color="{DynamicResource ShadowColor}" Direction="270"
                                          BlurRadius="0" ShadowDepth="0" Opacity="0.05" RenderingBias="Performance"/>
                    </Border.Effect>

                    <!-- Margin 即原 3D 方案的安全留白/卡间距（上下各 3px，相邻卡视觉缝隙 6px）；
                         卡片本体靠布局自动撑满，无需代码写死尺寸 -->
                    <Grid Margin="9,3">
                        <!-- 放大 → 上浮（都绕卡片中心，悬停进入动画驱动） -->
                        <Grid x:Name="LiftHost" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="CardLift" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- 卡片本体：左边直角 + 右边圆角（图标侧平齐，文字侧柔和）。
                                 CardTilt 是唯一的倾斜执行器：ScaleX 收缩 + 动态原点锚定远侧边缘。 -->
                            <Border x:Name="CardFace" CornerRadius="0,10,10,0"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CardTilt" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Panel}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                                 Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardSelectedBg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="0"
                                Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding IconFile}" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Border Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{DynamicResource IconPlaceholderStart}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource IconPlaceholderEnd}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Letter}" FontSize="23" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                            <!-- 名字 + 完结小奖杯：Auto/Auto 两列，长名字省略号收缩、奖杯恒完整紧贴其右（水平 StackPanel 会让省略号失效） -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DisplayName}"/>
                                <Viewbox Grid.Column="1" Width="12.5" Height="12.5" Margin="5,0,0,0"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                                         ToolTip="已完结">
                                    <!-- 与完结纪念卡同一只手绘金杯；单色淡金（深色淡金/浅色自动转深古铜） -->
                                    <Path Data="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.41 5 9.31 5 8zm14 0c0 1.31-.84 2.41-2 2.82V7h2v1z">
                                        <Path.Fill>
                                            <SolidColorBrush Color="{DynamicResource MemorialGoldLo}"/>
                                        </Path.Fill>
                                    </Path>
                                </Viewbox>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Border Style="{StaticResource Badge}">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding TypeBadge}"/>
                                </Border>
                                <TextBlock Text="{Binding LastPlayedText}" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding LastPlayedTip}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LastPlayedText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <!-- 星标固定在卡片最右：StackPanel 末尾是 24x24 正方星标按钮，右边距 5。
                             「自动」徽章在星标左侧动态显隐，徽章折叠也不改变星标 X 坐标。 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="0,0,5,0">
                            <!-- 动态显隐（Collapsed 不占位）：徽章在星标左侧，col2 是贴右缘的 Auto 列，
                                 折叠时列从左侧收缩，末尾星标的 X 坐标不变，无需恒占位。 -->
                            <Border CornerRadius="4" Padding="4.5,1.5" Margin="0,0,2,0" VerticalAlignment="Center"
                                    Background="{DynamicResource GreenSoft}" BorderBrush="{DynamicResource GreenSoftBorder}" BorderThickness="1"
                                    ToolTip="已开启自动备份（详情页可切换）"
                                    Visibility="{Binding AutoBackup, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="自动" FontSize="9.5" Foreground="{DynamicResource Green}"/>
                            </Border>
                            <Button Style="{StaticResource FavBtn}" Content="★" x:Name="FavStar" Click="OnToggleFavorite"/>
                        </StackPanel>

                        <!-- 倾斜方向暗角：鼠标偏向哪一侧，哪一侧的边缘就压暗，肉眼读作「该侧向内转远」，
                             弥补 2D 仿射没有真透视梯形的纵深感。方向/浓度由代码按鼠标 X 实时翻转。 -->
                        <Border x:Name="TiltShade" Grid.ColumnSpan="3" CornerRadius="0,10,10,0"
                                IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush x:Name="TiltShadeBrush" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#22000000" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="0.62"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- 跟随鼠标的扫光：绝对像素坐标的正圆径向渐变（相对坐标系在宽卡上会被拉成椭圆），
                             圆心/半径由代码后置按鼠标位置与卡宽实时更新，离开时淡出为 0。
                             三个色站构成「亮芯 → 柔和中段 → 完全透明」的衰减，模拟金属卡片扫光。 -->
                        <Border x:Name="GlowLayer" Grid.ColumnSpan="3" CornerRadius="0,10,10,0"
                                IsHitTestVisible="False" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush x:Name="GlowBrush" MappingMode="Absolute"
                                                     Center="150,29" GradientOrigin="150,29"
                                                     RadiusX="130" RadiusY="130">
                                    <GradientStop Color="{DynamicResource GlowColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource GlowColorMid}" Offset="0.4"/>
                                    <GradientStop Color="{DynamicResource GlowColorFade}" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 详情页 -->
        <DataTemplate x:Key="GameDetail" DataType="models:GameEntry">
            <!-- 沉浸语义覆盖字典不静态合并：由 Loaded 按当前主题动态挂载（仅深色），
                 浅色下不挂载、子树直接回落全局浅色键，彻底杜绝跨主题串色 -->
            <!-- 背景壁纸已上移到主体区通铺，ScrollViewer 自身保持透明：
                 深色透出通铺壁纸，浅色透出窗口 Bg（=原 UuBackdropBrush 奶油色） -->
            <ScrollViewer x:Name="DetailImmersiveRoot" Loaded="OnImmersiveRootLoaded"
                          VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel Margin="0">
                    <!-- 横幅 -->
                    <Grid Height="172" ClipToBounds="True">
                        <Image Source="{Binding CoverFile}" Stretch="UniformToFill"
                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}"/>
                        <Border Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVis}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource CoverPlaceholderStart}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource CoverPlaceholderEnd}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border>
                            <Border.Background>
                                <!-- 封面压暗遮罩：叠在图片上恒定为黑色渐变，保证底部标题可读（主题无关） -->
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="#EE000000" Offset="0"/>
                                    <GradientStop Color="#40000000" Offset="0.55"/>
                                    <GradientStop Color="#20000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                    HorizontalAlignment="Left" Margin="26,0,26,16"
                                    MouseLeftButtonUp="OnLocateInList" Cursor="Hand"
                                    ToolTip="在左侧列表中定位此游戏">
                            <Border Width="82" Height="82" CornerRadius="14" BorderBrush="{DynamicResource IconRing}"
                                    BorderThickness="2" ClipToBounds="True"
                                    Background="{DynamicResource Panel2}">
                                <Grid>
                                    <Image Source="{Binding IconFile}" Stretch="UniformToFill"
                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                    <Border Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource IconPlaceholderStart}" Offset="0"/>
                                                <GradientStop Color="{DynamicResource IconPlaceholderEnd}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Letter}" FontSize="34" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Bottom">
                                <!-- 横幅底部恒叠黑色压暗遮罩（见上方 #EE000000 渐变），任何主题/封面下都是暗底，
                                     故标题区文字固定浅色、不绑主题色，否则浅色主题下深字压暗底看不清 -->
                                <!-- 范例：游戏名黑色包围光晕（ShadowDepth=0 四周均匀、Blur=5），亮暗封面都能托住字 -->
                                <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="Bold"
                                           Foreground="#F5F7FA">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="0"
                                                          Opacity="0.9"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="{Binding SubName}" FontSize="12.5"
                                           Foreground="#C3C9D5" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis">
                                    <!-- 副标题配淡一档的同款黑色光晕 -->
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="0"
                                                          Opacity="0.7"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <!-- 窄窗口/侧栏拖宽时自动换行，末尾按钮不再被挤出横幅；
                                     所有徽章/按钮统一右距 6（末项除外），视觉等距，不再有 8/10 的参差 -->
                                <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <Border Style="{StaticResource HeroBadge}" VerticalAlignment="Center" Margin="0,0,6,6">
                                        <TextBlock Style="{StaticResource HeroBadgeText}" Text="{Binding TypeBadge}"/>
                                    </Border>
                                    <Border Style="{StaticResource HeroBadge}" VerticalAlignment="Center" Margin="0,0,6,6">
                                        <TextBlock Style="{StaticResource HeroBadgeText}" Text="{Binding BackupCountText}"/>
                                    </Border>
                                    <Button Style="{StaticResource BtnUuTeal}" FontSize="12.5" Padding="14,4"
                                            Content="▶ 运行游戏" x:Name="BtnRun" Margin="0,0,6,6" VerticalAlignment="Center"
                                            Click="OnRunGame"
                                            ToolTip="启动游戏：Steam 游戏通过 Steam 启动，学习版直接运行 exe（双击列表项同样可运行）"/>
                                    <Button Style="{StaticResource BtnSmOnHero}" Content="✎ 编辑" VerticalAlignment="Center" Margin="0,0,6,6"
                                            Click="OnEditGame"
                                            ToolTip="编辑中英文名称、封面、图标、AppId 和游戏 exe"/>
                                    <Button Style="{StaticResource BtnSmOnHero}" Content="📊 游玩详情" VerticalAlignment="Center" Margin="0,0,6,6"
                                            Click="OnShowPlayStats"
                                            ToolTip="查看导入日期、游玩总时长、最后关闭时间和历次会话记录"/>
                                    <!-- 完结馆入口：未完结→一键标记当天；已完结→绿色态，点击出「改日期/取消」菜单 -->
                                    <Button Style="{StaticResource BtnSmOnHero}" x:Name="BtnMarkCompleted" Content="🏆 完结撒花"
                                            VerticalAlignment="Center" Margin="0,0,6,6" Click="OnMarkCompleted"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVis}}"
                                            ToolTip="通关了？把这款游戏收入完结馆（日期记为今天，之后可补改）"/>
                                    <Button Style="{StaticResource BtnSmOnHero}" x:Name="BtnCompletedDone" VerticalAlignment="Center"
                                            Margin="0,0,6,6" Click="OnCompletedDoneClick"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                                            ToolTip="点击可修改完结日期或取消完结">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✓ 已完结 · " Foreground="#4ADE80"/>
                                            <TextBlock Text="{Binding CompletedShortText}" Foreground="#4ADE80"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BtnSmOnHero}" Content="移除游戏" VerticalAlignment="Center" Margin="0,0,6,6"
                                            Click="OnRemoveGame"/>
                                    <Button Style="{StaticResource BtnSmOnHero}" Content="刷新路径" Margin="0,0,0,6"
                                            VerticalAlignment="Center" Click="OnRefreshRules"
                                            ToolTip="强制联网刷新 Wiki 存档规则，并重跑本地规则（rules.json），自动补全存档目录"/>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 内容层：壁纸与辉光已上移到主体区左右通铺；此处只叠顶部重压渐变补横幅接缝 -->
                    <Grid ClipToBounds="True">
                        <Border Background="{DynamicResource UuArtVeilTop}"
                                Opacity="{DynamicResource UuArtOpacity}" IsHitTestVisible="False"/>
                        <StackPanel Margin="26,18,26,24">
                        <!-- 存档位置 -->
                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- 标题留白与下方「玩家存档与备份」分区一致：上 4、底 7 到分隔线 -->
                                <Grid Margin="16,4,16,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis">
                                        <Run Text="存档位置（"/><Run Text="{Binding SavePaths.Count, Mode=OneWay}"/><Run Text="）"/>
                                    </TextBlock>
                                    <!-- 窄窗口时标题省略，两按钮始终右贴且自然排列，不再用硬编码 104 让位 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource BtnSm}" Content="⚠ Wiki 获取失败 · 点击重试"
                                                Foreground="{DynamicResource Red}" Margin="0,0,8,0"
                                                Visibility="{Binding WikiFailed, Converter={StaticResource BoolToVis}}"
                                                Click="OnWikiRetry"
                                                ToolTip="Wiki 规则联网获取失败（缓存也无数据）。点击强制重试，成功后会自动补充存档路径"/>
                                        <Button Style="{StaticResource BtnSm}" Content="＋ 添加路径"
                                                Click="OnAddSavePath"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SavePaths}"
                                              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:SavePathEntry">
                                            <Grid Margin="16,5" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="▸" Foreground="{DynamicResource Accent2}"
                                                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="{DynamicResource Bg}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="12"
                                                               Foreground="{DynamicResource MonoText}" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                                                           VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Green}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Missing}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Red}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsReg}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent2}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="3" Style="{StaticResource BtnSm}" Content="打开"
                                                        Margin="0,0,6,0" Click="OnOpenSavePath"/>
                                                <Button Grid.Column="4" Style="{StaticResource BtnSm}" Content="移除"
                                                        Click="OnRemoveSavePath"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 玩家存档 + 备份记录（同一分区：玩家筹码在上，备份列表随玩家联动，操作栏在底） -->
                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="16,4,16,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">玩家存档与备份</TextBlock>
                                    <!-- 右侧整体右贴：弹性空位在前；空间不够时空位先归零，两段说明再各自省略号兜底（悬停看全文），绝不压上左侧标题 -->
                                    <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Text="存档＝当前进度，备份＝可还原副本" TextTrimming="CharacterEllipsis"
                                                   ToolTip="存档：游戏目录中正在读写的原文件，你玩到哪儿它就在那儿&#10;备份：本软件把存档打包保存的副本，游戏存档损坏或想回档时可随时还原"/>
                                        <TextBlock Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding DataContext.PolicyText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   ToolTip="{Binding DataContext.PolicyText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Grid>
                                </Grid>

                                <!-- Steam 云同步游戏：禁用玩家档案（紧凑徽章，详情在悬停提示里；备份功能不受影响） -->
                                <Border Margin="16,0,16,8" Padding="10,4" CornerRadius="6"
                                        Background="{DynamicResource Panel2}" HorizontalAlignment="Left"
                                        Visibility="{Binding HasCloudSave, Converter={StaticResource BoolToVis}}"
                                        ToolTip="该游戏使用 Steam 云同步，多个玩家的存档会被云档互相覆盖，因此禁用了玩家存档。&#10;如需多人各玩各的，请先在 Steam 中关闭该游戏的云同步。">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                               Text="玩家存档已禁用（Steam 云同步游戏）"/>
                                </Border>

                                <StackPanel Visibility="{Binding HasCloudSave, Converter={StaticResource InverseBoolToVis}}">
                                    <!-- 玩家筹码行：默认就有系统建好的「玩家1」，点击名字即切换；
                                         右键筹码可重命名/删除，右下「＋ 新玩家」加更多人 -->
                                    <!-- 下边距 -2.5：抵消筹码按钮自身 6px 的底部 margin，使最后一行到分界线视觉间距为 3.5px；
                                         筹码自身 margin 仍保留，供多玩家换行时的行间距 -->
                                    <WrapPanel Margin="16,3,16,-2.5">
                                        <ItemsControl ItemsSource="{Binding ProfileSlots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="models:ProfileSlotVm">
                                                    <Button Margin="0,0,8,6" Padding="12,4" Cursor="Hand"
                                                            Click="OnSwitchPlayer"
                                                            ToolTip="{Binding StatusTip}"
                                                            MaxWidth="168">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                                                                <Setter Property="Background" Value="{DynamicResource Panel2}"/>
                                                                <Setter Property="FontSize" Value="12.5"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <!-- 右键菜单：VM 由处理器经 ContextMenu.PlacementTarget 取得（ContextMenu 不在可视化树，不继承 DataContext） -->
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="重命名玩家" Click="OnRenamePlayer"/>
                                                                <MenuItem Header="删除玩家（含其备份）" Click="OnDeletePlayer"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <StackPanel>
                                                            <!-- 第一行：名字 + 当前徽章（圆点已去除，颜色仅靠当前徽章区分） -->
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                           MaxWidth="108" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Name}"/>
                                                                <Border CornerRadius="5" Padding="5,1" Margin="8,0,0,0"
                                                                        Background="{DynamicResource OnPrimaryOverlay}"
                                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="当前" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <!-- 第二行：当前玩家=live 核对状态（已备份/有新进度/游玩中/本机或云端有较新备份），其他玩家=最近备份时间；
                                                                 短词+限宽省略号，防止筹码过长或文字被裁。
                                                                 「本机/云端有较新备份」时整行是可点链接（IsHitTestVisible 放开、手型、下划线），
                                                                 其他状态命中穿透到外层筹码按钮，照常切换玩家 -->
                                                            <Button Click="OnSlotStatusClick" Margin="0,1,0,0" Padding="0"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Cursor="Hand" IsHitTestVisible="{Binding StatusClickable}"
                                                                    ToolTip="{Binding StatusTip}"
                                                                    Visibility="{Binding StatusText, Converter={StaticResource BlankToCollapsed}}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <ContentPresenter/>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="144">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding StatusKind}" Value="good">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent2}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Orange}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding StatusKind}" Value="info">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                                                </DataTrigger>
                                                                                <!-- 可点链接加下划线 -->
                                                                                <DataTrigger Binding="{Binding StatusAction}" Value="restoreFavorite">
                                                                                    <Setter Property="TextDecorations" Value="Underline"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding StatusAction}" Value="restoreCloud">
                                                                                    <Setter Property="TextDecorations" Value="Underline"/>
                                                                                </DataTrigger>
                                                                                <!-- 选中芯片是蓝底：普通态弱白；好/坏/链接态用蓝底上可读的浅绿/浅琥珀/浅蓝 -->
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsActive}" Value="True"/>
                                                                                        <Condition Binding="{Binding StatusKind}" Value="normal"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryTextMuted}"/>
                                                                                </MultiDataTrigger>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsActive}" Value="True"/>
                                                                                        <Condition Binding="{Binding StatusKind}" Value="good"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Foreground" Value="#8FE0B4"/>
                                                                                </MultiDataTrigger>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsActive}" Value="True"/>
                                                                                        <Condition Binding="{Binding StatusKind}" Value="warn"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Foreground" Value="#FFD27D"/>
                                                                                </MultiDataTrigger>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsActive}" Value="True"/>
                                                                                        <Condition Binding="{Binding StatusKind}" Value="info"/>
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Foreground" Value="#AECAFF"/>
                                                                                    <Setter Property="TextDecorations" Value="Underline"/>
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>
                                                            <!-- 次要事实标记：还旧档后在状态行旁保留「刚还原到的存档时间」痕迹；
                                                                 蓝底选中筹码上用浅色（与状态行 good 态同一套浅绿），未选中走 Accent2 -->
                                                            <TextBlock Text="{Binding RestoredTagText}" ToolTip="{Binding RestoredTagTip}"
                                                                       FontSize="9.5" Margin="8,0,8,2" MaxWidth="152"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding RestoredTagText, Converter={StaticResource BlankToCollapsed}}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Accent2}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter Property="Foreground" Value="#8FE0B4"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource Btn}" Content="＋ 新玩家" Padding="12,4"
                                                FontSize="12.5" Margin="0,0,8,6" Click="OnNewProfile"
                                                ToolTip="再建一位玩家：创建后启动游戏，在主菜单选「新游戏」开始他自己的进度（他的备份列表从空开始）；右键玩家名可重命名或删除"/>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- 备份记录（与玩家联动） -->
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <Grid Margin="16,7,16,1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">备份记录</TextBlock>
                                                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11.5"
                                                           Foreground="{DynamicResource Accent2}"
                                                           Text="{Binding BackupOwnerText}"
                                                           Visibility="{Binding HasProfileSlots, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding EmptyBackupHint}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"
                                                   Margin="0,10,0,10" TextWrapping="Wrap"
                                                   Visibility="{Binding HasVisibleBackups, Converter={StaticResource InverseBoolToVis}}"/>
                                        <ItemsControl ItemsSource="{Binding VisibleBackups}"
                                                      Visibility="{Binding HasVisibleBackups, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="models:BackupRecord">
                                                    <!-- 行底极淡分隔线（全宽，比分区边框弱一档；末行线与操作栏线相距约 11px，不打架） -->
                                                    <Border BorderBrush="{DynamicResource RowDivider}" BorderThickness="0,0,0,1">
                                                    <Grid Margin="16,3"
                                                          MouseLeftButtonUp="OnBackupRowClick">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource RowHoverOverlay}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="185"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="34" CornerRadius="5" Padding="0,1.5"
                                                                VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource KindFullBg}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsIncr}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Accent2Soft}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding KindText}" FontSize="10" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsIncr}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Accent2}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Note}" FontSize="12.5"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Note}"/>
                                                            <!-- 第二行：存档大小 + 压缩率（任何记录都有） -->
                                                            <TextBlock Text="{Binding SizeDetailText}" FontSize="10.5"
                                                                       Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding SizeDetailText}"/>
                                                        </StackPanel>
                                                        <!-- 时间列（在备注右侧）：主行存档时刻、副行备份时刻，字号一致、右对齐成列；
                                                                 右缘留出 24px 间距，不与旁边的云端按钮相挤 -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                    Margin="0,0,24,0">
                                                            <TextBlock Text="{Binding SavedAtMainText}" FontFamily="Consolas"
                                                                       FontSize="12" TextAlignment="Right"
                                                                       Foreground="{DynamicResource TextSecondary}"/>
                                                            <TextBlock Text="{Binding BackupTimeText}" FontFamily="Consolas"
                                                                       FontSize="12" TextAlignment="Right" Margin="0,1,0,0"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       Visibility="{Binding BackupTimeText, Converter={StaticResource BlankToCollapsed}}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                            <!-- 橙色感叹号：这份备份的存档时间新于当前 live（典型：手动还原到旧档后，
                                                                 库里更新的备份逐行提示）；纯指示不可单独操作，悬停看两个存档时间，点击冒泡给整行。
                                                                 槽位固定 15+6=21px 常驻（图标折叠、槽位不塌），保证各行时间戳右缘对齐 -->
                                                            <Border Width="15" Margin="0,0,6,0" VerticalAlignment="Center" Background="Transparent"
                                                                    ToolTip="{Binding NewerThanLiveTip}">
                                                                <Viewbox Width="15" Height="15"
                                                                         Visibility="{Binding IsNewerThanLive, Converter={StaticResource BoolToVis}}">
                                                                    <Path Fill="{DynamicResource Orange}"
                                                                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                                                                </Viewbox>
                                                            </Border>
                                                            <!-- 矢量实心锁（WPF 不支持 emoji 彩色字形，故用 Path 真涂色）：
                                                                 未锁=灰、锁定=金；Data 为 24x24 Material 实心锁/开锁轮廓 -->
                                                            <Button Style="{StaticResource BtnSm}" Margin="0,0,6,0" Click="OnToggleLock"
                                                                    Padding="7,3"
                                                                    ToolTip="锁定后，超过保留份数自动清理时不会删这份（手动删除不受影响）">
                                                                <Viewbox Width="14" Height="14">
                                                                    <Path>
                                                                        <Path.Style>
                                                                            <Style TargetType="Path">
                                                                                <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
                                                                                <Setter Property="Data" Value="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6h2c0-1.66 1.34-3 3-3s3 1.34 3 3v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm0 12H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Locked}" Value="True">
                                                                                        <Setter Property="Fill" Value="{DynamicResource GoldLock}"/>
                                                                                        <Setter Property="Data" Value="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Path.Style>
                                                                    </Path>
                                                                </Viewbox>
                                                            </Button>
                                                            <!-- 云按钮：与锁同款 13px 矢量图标——未传=灰云，已存=绿云带勾，已删=灰云；
                                                                 文字保留明示操作；已存禁用但自定义模板不压暗 -->
                                                            <Button MinWidth="92" Margin="0,0,6,0" Click="OnUploadBackup"
                                                                    ToolTip="把这份备份上传到云盘（WebDAV）">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnSm}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CloudUploaded}" Value="True">
                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                                <Setter Property="Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="Button">
                                                                                            <Border Background="Transparent"
                                                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                                                    BorderThickness="1" CornerRadius="8" Padding="10,3">
                                                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                                                            </Border>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>
                                                                            <!-- 已删重传态放最后：优先级高于已存，且保持可点 -->
                                                                            <DataTrigger Binding="{Binding CloudDeleted}" Value="True">
                                                                                <Setter Property="Background" Value="Transparent"/>
                                                                                <Setter Property="IsEnabled" Value="True"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <Viewbox Width="13" Height="13" Margin="0,0,5,0">
                                                                        <Path>
                                                                            <Path.Style>
                                                                                <Style TargetType="Path">
                                                                                    <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
                                                                                    <Setter Property="Data" Value="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding CloudUploaded}" Value="True">
                                                                                            <Setter Property="Fill" Value="{DynamicResource Green}"/>
                                                                                            <Setter Property="Data" Value="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17.41 13.41l-4.19 4.18c-.39.39-1.02.39-1.41 0l-2.08-2.08 1.41-1.41 1.37 1.37 3.48-3.48 1.42 1.42z"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Path.Style>
                                                                        </Path>
                                                                    </Viewbox>
                                                                    <TextBlock FontSize="11.5" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="上传云端"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CloudUploaded}" Value="True">
                                                                                        <Setter Property="Text" Value="云端已存"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding CloudDeleted}" Value="True">
                                                                                        <Setter Property="Text" Value="已删重传"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Style="{StaticResource BtnSm}" Content="改名" MinWidth="46" Margin="0,0,6,0"
                                                                    Click="OnEditBackupNote" ToolTip="修改此备份的名称"/>
                                                            <Button Style="{StaticResource BtnSm}" Content="还原" MinWidth="46" Margin="0,0,6,0"
                                                                    Click="OnRestoreBackup"/>
                                                            <Button Style="{StaticResource BtnSm}" Content="删除" MinWidth="46" Click="OnDeleteBackup"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 操作栏（同分区底部） -->
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource BtnPrimary}" FontSize="14" Padding="24,8"
                                                        Content="⬇ 立即备份" Margin="0,0,10,0" Click="OnBackupNow"
                                                        ToolTip="立即把当前游戏进度打包成备份（启用玩家后只保存当前玩家的进度）&#10;备份存储于 AppData\GameSaveVault\backups"/>
                                                <Button Grid.Column="1" Style="{StaticResource Btn}" Content="还原最近" Margin="0,0,18,0"
                                                        Click="OnRestoreLatest"
                                                        ToolTip="还原当前玩家最近的一份备份"/>
                                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleBtn}" Content="退出游戏时备份"
                                                          IsChecked="{Binding AutoBackup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Checked="OnAutoToggled" Unchecked="OnAutoToggled" VerticalAlignment="Center"
                                                          Margin="0,0,10,0"/>
                                                <CheckBox Grid.Column="3" Style="{StaticResource ToggleBtn}" Content="运行中定时快照"
                                                          IsChecked="{Binding HotSnapshot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Checked="OnHotToggled" Unchecked="OnHotToggled" VerticalAlignment="Center"
                                                          Margin="0,0,10,0"
                                                          ToolTip="游戏运行期间每隔 N 分钟自动备份一次存档（间隔在 设置 → 备份 中配置）"/>
                                                <CheckBox Grid.Column="4" Style="{StaticResource ToggleBtn}" Content="自动云存档"
                                                          IsChecked="{Binding CloudAuto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Checked="OnCloudAutoToggled" Unchecked="OnCloudAutoToggled"
                                                          VerticalAlignment="Center" Margin="0,0,16,0"
                                                          ToolTip="开启后：该游戏新备份自动上传云端；启动时自动下载云端缺失的备份（只进备份列表，&#10;不会自动覆盖游戏存档，还原仍需你确认）。需先在 设置 → 云同步 配置并测试连接。"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- 完结馆海报卡片：真 3D 透视倾斜。卡片通过 Viewport2DVisual3D 贴在 3D 平面上，
             透视相机下鼠标带动 rotateX/rotateY：左右倾时近侧边缘真实放大、上下方向同样能转；
             全直角无圆角。视口比卡片大一圈（236×336 对 200×300），给倾斜外扩与投影留位。
             暗角/扫光/投影在 code-behind 的 OnPosterTilt* 中按鼠标位置驱动。 -->
        <DataTemplate x:Key="CompletedCard" DataType="models:GameEntry">
            <Grid x:Name="CardRoot" Width="200" Height="300" Margin="0,0,12,12" Background="Transparent">
                <Border x:Name="PcShadowHost" Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect x:Name="PcShadow" Color="{DynamicResource ShadowColor}" Direction="270"
                                          BlurRadius="0" ShadowDepth="0" Opacity="0.12" RenderingBias="Quality"/>
                    </Border.Effect>
                    <Viewport3D Width="236" Height="336" Margin="-18,-18" Focusable="False">
                        <Viewport3D.Camera>
                            <PerspectiveCamera Position="0,0,520" LookDirection="0,0,-1" UpDirection="0,1,0"
                                                FieldOfView="32" NearPlaneDistance="10" FarPlaneDistance="3000"/>
                        </Viewport3D.Camera>
                        <!-- 无灯光时 VisualHost 的 DiffuseMaterial 在部分机器/GPU 上渲染为纯黑，必须放一盏环境光 -->
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <AmbientLight Color="White"/>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                        <Viewport2DVisual3D>
                            <Viewport2DVisual3D.Transform>
                                <Transform3DGroup>
                                    <ScaleTransform3D ScaleX="200" ScaleY="300" ScaleZ="1"/>
                                    <RotateTransform3D>
                                        <RotateTransform3D.Rotation>
                                            <AxisAngleRotation3D x:Name="PcRotY" Axis="0,1,0" Angle="0"/>
                                        </RotateTransform3D.Rotation>
                                    </RotateTransform3D>
                                    <RotateTransform3D>
                                        <RotateTransform3D.Rotation>
                                            <AxisAngleRotation3D x:Name="PcRotX" Axis="1,0,0" Angle="0"/>
                                        </RotateTransform3D.Rotation>
                                    </RotateTransform3D>
                                    <TranslateTransform3D x:Name="PcLift" OffsetX="0" OffsetY="0" OffsetZ="0"/>
                                </Transform3DGroup>
                            </Viewport2DVisual3D.Transform>
                            <Viewport2DVisual3D.Geometry>
                                <MeshGeometry3D Positions="-0.5,0.5,0 -0.5,-0.5,0 0.5,-0.5,0 0.5,0.5,0"
                                                TriangleIndices="0 1 2 0 2 3"
                                                TextureCoordinates="0,0 0,1 1,1 1,0"/>
                            </Viewport2DVisual3D.Geometry>
                            <Viewport2DVisual3D.Material>
                                <DiffuseMaterial Brush="White" Viewport2DVisual3D.IsVisualHostMaterial="True"/>
                            </Viewport2DVisual3D.Material>
                            <Viewport2DVisual3D.Visual>
                                <Border x:Name="PcFace" Width="200" Height="300" ClipToBounds="True"
                                        Background="{DynamicResource Panel2}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Cursor="Hand"
                                        MouseEnter="OnPosterTiltEnter" MouseMove="OnPosterTiltMove"
                                        MouseLeave="OnPosterTiltLeave" MouseLeftButtonUp="OnCompletedCardClick">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorder}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="🖼 换海报…" Click="OnCompletedChangePoster"/>
                                            <MenuItem Header="↩ 恢复官方竖海报" Click="OnCompletedResetPoster"
                                                      Visibility="{Binding HasCustomPoster, Converter={StaticResource BoolToVis}}"/>
                                            <MenuItem Header="📅 修改完结日期…" Click="OnCompletedEditDate"/>
                                            <MenuItem Header="✕ 取消完结" Click="OnCompletedUnmark"
                                                      Visibility="{Binding Archived, Converter={StaticResource InverseBoolToVis}}"/>
                                            <MenuItem Header="🗑 彻底删除档案…" Click="OnCompletedDeleteArchive"
                                                      Visibility="{Binding Archived, Converter={StaticResource BoolToVis}}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <!-- 归档角标：游戏已从库中移除，仅留通关档案（卡片全直角，角标也不用圆角） -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                                                Background="#CC14161C" Padding="7,3"
                                                Visibility="{Binding Archived, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="已移出" FontSize="11" Foreground="#FFC2CBE0"/>
                                        </Border>
                                        <Image Source="{Binding PosterDisplayFile}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding HasPosterDisplay, Converter={StaticResource BoolToVis}}"/>
                                        <Border Visibility="{Binding HasPosterDisplay, Converter={StaticResource InverseBoolToVis}}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{DynamicResource IconPlaceholderStart}" Offset="0"/>
                                                    <GradientStop Color="{DynamicResource IconPlaceholderEnd}" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Letter}" FontSize="64" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- 底部压暗：恒定黑色渐变，保证游戏名可读（主题无关） -->
                                        <Border Height="100" VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                    <GradientStop Color="#E6000000" Offset="0"/>
                                                    <GradientStop Color="#55000000" Offset="0.65"/>
                                                    <GradientStop Color="#00000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,12">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold"
                                                       Foreground="White" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding DisplayName}"/>
                                            <TextBlock Text="{Binding CompletedDateText}" FontSize="12" Margin="0,4,0,0"
                                                       Foreground="#FFE6A8"/>
                                        </StackPanel>
                                        <!-- rotateX（上下倾）方向暗角：纵向渐变 -->
                                        <Border x:Name="PcShadeY" IsHitTestVisible="False" Opacity="0">
                                            <Border.Background>
                                                <LinearGradientBrush x:Name="PcShadeYBrush" StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#22000000" Offset="0"/>
                                                    <GradientStop Color="#00000000" Offset="0.62"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <!-- rotateY（左右倾）方向暗角：横向渐变 -->
                                        <Border x:Name="PcShadeX" IsHitTestVisible="False" Opacity="0">
                                            <Border.Background>
                                                <LinearGradientBrush x:Name="PcShadeXBrush" StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#22000000" Offset="0"/>
                                                    <GradientStop Color="#00000000" Offset="0.62"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <!-- 跟随鼠标的扫光：绝对像素径向渐变，圆心由 code-behind 更新 -->
                                        <Border x:Name="PcGlow" IsHitTestVisible="False" Opacity="0">
                                            <Border.Background>
                                                <RadialGradientBrush x:Name="PcGlowBrush" MappingMode="Absolute"
                                                                     Center="100,150" GradientOrigin="100,150"
                                                                     RadiusX="130" RadiusY="130">
                                                    <GradientStop Color="{DynamicResource GlowColor}" Offset="0"/>
                                                    <GradientStop Color="{DynamicResource GlowColorMid}" Offset="0.4"/>
                                                    <GradientStop Color="{DynamicResource GlowColorFade}" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Viewport2DVisual3D.Visual>
                        </Viewport2DVisual3D>
                    </Viewport3D>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 列表容器 -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="10" Padding="10,7" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Panel2}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemSelectedBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentSoftBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <!-- 重写模板：默认模板在 IsEnabled=False（忙碌安全锁 RootGrid.IsEnabled=false）时
                 会把背景强制改成系统灰色 ControlBrush，任务进行期间列表会灰闪一下。
                 自定义模板不含该触发器，禁用时背景保持 Transparent，视觉无变化。 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Padding="0" Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题切换浮窗用的 chip：无勾选框，选中态由背景/边框色表达 -->
        <Style x:Key="ChipSm" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="11" Padding="12,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 性能：默认 ToolTip 模板用 SystemDropShadowChrome（软件投影），且首次打开要新建透明分层
             HWND + 冷加载样式，实测在 GPU 被游戏占用时同步卡 UI 线程 1.4 秒。改用零投影轻量模板。 -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource ToolTipBg}" BorderBrush="{DynamicResource ToolTipBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="9,4">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自绘标题栏按钮：46x32 系统尺寸，Segoe MDL2 矢量字形，透明底、悬停轻罩；
             IsHitTestVisibleInChrome 让按钮在标题拖拽区内仍可点 -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource CaptionGlyph}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CaptionHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CaptionPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 关闭键：必须重写模板——基模板悬停时直接给内部 Border 设了 CaptionHoverBg，
             只在 Style 层改 Background 会被它压过；这里悬停整块半透明红、字形变白，按下加深 -->
        <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CaptionCloseHoverBg}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0C4251D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 性能：透明分层 Popup 上的 DropShadowEffect 会在首次打开时触发大尺寸软件位图模糊，
             同步阻塞 UI 线程可达 1 秒以上（全屏游戏占用 GPU 时更甚）。浮层改用 1px 描边分层，零 Effect。 -->
    </Window.Resources>

    <!-- 外层容器：更新数据库时 RootGrid 整体禁用，停止按钮放在外层才可点 -->
    <Grid>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 全窗口统一艺术底：壁纸从自绘标题栏一路铺到状态栏（深色显示；浅色 UuArtOpacity=0 整层隐藏）。
             必须是一张跨四行的 Image：若上下分段，UniformToFill 各自裁切会在工具栏/状态栏边缘露出拼缝 -->
        <Grid Grid.RowSpan="4" Opacity="{DynamicResource UuArtOpacity}"
              IsHitTestVisible="False" ClipToBounds="True">
            <Image Source="/GameSaveVault;component/Assets/immersive_wallpaper.png"
                   Stretch="UniformToFill"/>
            <Border Background="{DynamicResource UuArtVeilFlat}"/>
            <Border Background="{DynamicResource UuGlowTealBrush}"/>
            <Border Background="{DynamicResource UuGlowIndigoBrush}"/>
        </Grid>

        <!-- 自绘标题栏（32px，最小化/最大化/关闭为右侧三颗自绘按钮）：
             其余区域即标题拖拽区；深色全透壁纸+顶部渐隐压条，浅色不透明白 -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBarBg}">
            <Grid>
                <Border Background="{DynamicResource UuChromeScrim}" Opacity="{DynamicResource UuArtOpacity}"
                        IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/app.ico" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="GameSaveVault" FontSize="12" Margin="9,1,0,0"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 自绘窗口按钮（右起：关闭/最大化/最小化），字形 Segoe MDL2 Assets -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="CaptionMinBtn" Style="{StaticResource CaptionBtn}" Click="OnCaptionMinimize"
                            ToolTip="最小化" Content="&#xE921;"/>
                    <Button x:Name="CaptionMaxBtn" Style="{StaticResource CaptionBtn}" Click="OnCaptionToggleMax"
                            ToolTip="最大化">
                        <TextBlock x:Name="CaptionMaxGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="CaptionCloseBtn" Style="{StaticResource CaptionCloseBtn}" Click="OnCaptionClose"
                            ToolTip="关闭" Content="&#xE8BB;"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="{DynamicResource ChromeBarBg}" BorderBrush="{DynamicResource ChromeBarBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnScan" Style="{StaticResource BtnTool}" Content="⟳ 扫描 Steam"
                            Margin="0,0,10,0" Click="OnScanSteam"/>
                    <Button Style="{StaticResource BtnTool}" Content="＋ 添加游戏" Margin="0,0,10,0" Click="OnAddGameWizard"
                            ToolTip="选择游戏文件夹批量扫描，或手动指定单个游戏 exe"/>
                    <Button Style="{StaticResource BtnTool}" Content="☁ 云存档" Margin="0,0,10,0" Click="OnOpenCloudBrowser"
                            ToolTip="浏览/下载/删除云端备份（WebDAV：坚果云/NAS 等）"/>
                    <Button x:Name="BtnCompleted" Style="{StaticResource BtnTool}" Content="🏆 完结馆" Margin="0,0,10,0"
                            Click="OnOpenCompleted" ToolTip="已通关游戏的海报墙，按完结时间排列"/>
                    <Button x:Name="BtnMore" Style="{StaticResource BtnTool}" Content="⋯ 更多" Margin="0,0,10,0"
                            Click="OnMoreMenuClick"/>
                    <Button Style="{StaticResource BtnTool}" Content="⚙ 设置" Margin="0,0,10,0" Click="OnOpenSettings"/>
                    <TextBlock x:Name="BusyText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Accent2}" Visibility="Collapsed" Text="处理中…"/>
                </StackPanel>

                <!-- 右上角主题切换小图标按钮：点开浮窗三选一，选中即生效并保存。
                     用户要求：按钮本身不要外圈描边（厚度保留 1px 仅防悬停位移），悬停只出底色 -->
                <Button x:Name="ThemeBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="7,4" Cursor="Hand" Click="OnThemeBtnClick"
                        Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                        ToolTip="外观主题">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnHoverBg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="ThemeIcon" Text="🌙" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                </Button>

                <!-- 主题浮窗：横向三选一 chip，向窗口内侧（左）展开，无勾选框 -->
                <Popup x:Name="ThemePopup" Placement="Left" PlacementTarget="{Binding ElementName=ThemeBtn}"
                       HorizontalOffset="-6" VerticalOffset="0" AllowsTransparency="True"
                       StaysOpen="False" PopupAnimation="Fade">
                    <!-- 用户要求：弹窗外圈描边去掉，只留面板底色；内部 4 个 chip 自身描边保留 -->
                    <Border x:Name="ThemePopupBody" Background="{DynamicResource Panel}"
                            BorderThickness="0" CornerRadius="10" Padding="6">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeChipSystem" Style="{StaticResource ChipSm}" Content="跟随系统"
                                         GroupName="ThemePopup" Tag="system" Checked="OnThemePopupChecked"/>
                            <RadioButton x:Name="ThemeChipLight" Style="{StaticResource ChipSm}" Content="清新浅色"
                                         GroupName="ThemePopup" Tag="light" Checked="OnThemePopupChecked"/>
                            <RadioButton x:Name="ThemeChipLightSoft" Style="{StaticResource ChipSm}" Content="素雅浅色"
                                         GroupName="ThemePopup" Tag="lightsoft" Checked="OnThemePopupChecked"/>
                            <RadioButton x:Name="ThemeChipDark" Style="{StaticResource ChipSm}" Content="深色"
                                         GroupName="ThemePopup" Tag="dark" Checked="OnThemePopupChecked"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid x:Name="MainBody" Grid.Row="2" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideCol" Width="310" MinWidth="240" MaxWidth="520"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- 艺术底已上移到 RootGrid 跨四行通铺（标题栏→状态栏），此处不再重复铺，
                 避免双层 Image 各自裁切产生拼缝、双层 VeilFlat 叠加导致压暗翻倍 -->

            <!-- 侧边栏：深色底色全透（SideBarBg），壁纸直透与右侧连成一片；
                 玻璃语义覆盖由 Loaded 仅在深色挂载 ImmersiveScope，浅色为不透明白零变化 -->
            <Border Grid.Column="0" x:Name="SideBar" Background="{DynamicResource SideBarBg}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0" Loaded="OnImmersiveRootLoaded">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,4">
                        <Grid>
                            <TextBox x:Name="SearchBox" Height="34" FontSize="13" Padding="10,0,32,0"
                                     VerticalContentAlignment="Center" TextChanged="OnSearchChanged"
                                     Background="{DynamicResource Bg}" Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource BorderBrush}" CaretBrush="{DynamicResource TextPrimary}"
                                     BorderThickness="1">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Button Style="{StaticResource SearchClearBtn}" Content="✕" x:Name="SearchClear"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Click="OnClearSearch"/>
                        </Grid>
                        <WrapPanel Margin="0,10,0,2">
                            <RadioButton x:Name="FiltAll" Style="{StaticResource Chip}" GroupName="ft"
                                         Content="全部" IsChecked="True" Checked="OnFilterChanged" Margin="0,0,6,4"/>
                            <RadioButton x:Name="FiltSteam" Style="{StaticResource Chip}" GroupName="ft"
                                         Content="Steam" Checked="OnFilterChanged" Margin="0,0,6,4"/>
                            <RadioButton x:Name="FiltLocal" Style="{StaticResource Chip}" GroupName="ft"
                                         Content="本地版" Checked="OnFilterChanged" Margin="0,0,6,4"/>
                            <!-- 已完结快捷筛选：已通关游戏平时沉在列表底部，点这里一键只看完结的 -->
                            <RadioButton x:Name="FiltCompleted" Style="{StaticResource Chip}" GroupName="ft"
                                         Content="已完结" Checked="OnFilterChanged" Margin="0,0,0,4"
                                         ToolTip="只看已通关的游戏；平时它们自动沉在列表底部"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                            <!-- 排序 chip 自带方向：点未选中的切换排序方式，再点一次当前 chip 切换升降序 -->
                            <RadioButton x:Name="RSortAdded" Style="{StaticResource Chip}" GroupName="sort"
                                         Checked="OnSortChipChanged" Margin="0,0,6,0"
                                         PreviewMouseLeftButtonDown="OnSortChipReclick"
                                         ToolTip="查看最近添加的游戏；再点一次切换升降序">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="最近添加"/>
                                    <Border x:Name="RecentAddedDot" Width="6" Height="6" CornerRadius="3"
                                            Background="{DynamicResource Accent}" Margin="5,0,0,0"
                                            VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <TextBlock x:Name="AddedDir" Text="↓" Margin="4,0,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RSortPlayed" Style="{StaticResource Chip}" GroupName="sort"
                                         IsChecked="True" Checked="OnSortChipChanged" Margin="0,0,6,0"
                                         PreviewMouseLeftButtonDown="OnSortChipReclick"
                                         ToolTip="按最近游玩排序；再点一次切换升降序">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="最近游玩"/>
                                    <TextBlock x:Name="PlayedDir" Text="↓" Margin="4,0,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RSortName" Style="{StaticResource Chip}" GroupName="sort"
                                        Checked="OnSortChipChanged"
                                        PreviewMouseLeftButtonDown="OnSortChipReclick"
                                        ToolTip="按名称排序；再点一次切换升降序">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="名称"/>
                                    <TextBlock x:Name="NameDir" Text="↓" Margin="4,0,0,0"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="SideCount" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" x:Name="SideSize" FontSize="11.5" Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="GamesList" ItemTemplate="{StaticResource GameListItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,4,0,4"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             SelectionChanged="OnGameSelected" MouseDoubleClick="OnListItemDoubleClick"
                             PreviewMouseLeftButtonDown="OnGamesListPreviewMouseDown">
                        <ListBox.Resources>
                            <!-- 容器所有状态背景全透明：不再有铺满整行的蓝色悬停/选中背板。
                                 悬停反馈交给卡片放大上浮阴影；选中区分由卡片底色自身中性微亮
                                 （在 GameListItem 模板内绑定 ListBoxItem.IsSelected），随卡片一起变形。 -->
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 拖动分隔条：调节侧栏/详情宽度 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Cursor="SizeWE" ResizeBehavior="PreviousAndNext" ResizeDirection="Auto"
                          DragCompleted="OnSidebarResized" ToolTip="拖动调节列表宽度">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="bar" Width="1" HorizontalAlignment="Center"
                                       Fill="{DynamicResource BorderBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource AccentSoftBorder}"/>
                                <Setter TargetName="bar" Property="Width" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- 详情 -->
            <Grid Grid.Column="2">
                <!-- 未选中游戏时折叠宿主：DataTemplate 即便 Content=null 仍会实例化，
                     不折叠会在空态玻璃下透出空段落/占位紫块（鬼影），必须整体隐藏 -->
                <ContentControl x:Name="DetailHost" Content="{Binding SelectedGame}"
                                ContentTemplate="{StaticResource GameDetail}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <!-- 未选中游戏：右侧显示清新风格海报（覆盖在详情之上，用平移切换规避渲染异常）。
                     深色全透=通铺壁纸与左侧连续；浅色不透明奶油色（=原 Bg，零变化）；
                     ImmersiveScope 仅深色挂载，让中间卡片玻璃化 -->
                <Border x:Name="EmptyState" Background="{DynamicResource EmptyStateBg}"
                        IsHitTestVisible="False" Loaded="OnImmersiveRootLoaded">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="PosterTransform" X="9999"/>
                    </Border.RenderTransform>
                    <Grid Margin="44">
                        <Border CornerRadius="22" Background="{DynamicResource Panel}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="132" Height="132" CornerRadius="66"
                                        Background="{DynamicResource Panel2}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        HorizontalAlignment="Center">
                                    <Viewbox Width="72" Height="72">
                                        <Path Fill="{DynamicResource Accent}" Stretch="Uniform"
                                              Data="M21,6H3C1.9,6 1,6.9 1,8v8c0,1.1 0.9,2 2,2h18c1.1,0 2,-0.9 2,-2V8C23,6.9 22.1,6 21,6zM11,13H8v3H6v-3H3v-2h3V8h2v3h3V13zM15.5,15c-0.83,0 -1.5,-0.67 -1.5,-1.5s0.67,-1.5 1.5,-1.5 1.5,0.67 1.5,1.5S16.33,15 15.5,15zM19.5,12c-0.83,0 -1.5,-0.67 -1.5,-1.5S18.67,9 19.5,9s1.5,0.67 1.5,1.5S20.33,12 19.5,12z"/>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="GameSaveVault" FontSize="30" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Center" Margin="0,24,0,0"/>
                                <TextBlock Text="选择左侧游戏，开始管理你的存档" FontSize="14"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 完结馆：整层覆盖主体区（顶工具栏与状态栏保留）；Esc/返回/点卡片离开。
             收藏墙底色用专用全透键 UuHallBackdropBrush（露通铺壁纸）；
             完结回顾详情另用不透明的 UuBackdropBrush，两者不可共用 -->
        <Border x:Name="CompletedView" Grid.Row="2" Background="{DynamicResource UuHallBackdropBrush}"
                Visibility="Collapsed" Focusable="True" Loaded="OnImmersiveRootLoaded">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 收藏墙不内嵌壁纸：只露 RootGrid 跨四行的通铺壁纸（主界面主体已隐藏，
                     不会透出列表，也无双层 UniformToFill 拼缝）；完结回顾详情另起不透明层 -->
                <!-- 沉浸辉光层（通铺顶栏与收藏墙；浅色主题全透明） -->
                <Border Grid.RowSpan="2" Background="{DynamicResource UuGlowTealBrush}"/>
                <Border Grid.RowSpan="2" Background="{DynamicResource UuGlowIndigoBrush}"/>
                <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="16,9">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnCompletedBack" Style="{StaticResource Btn}" Content="← 返回"
                                    Click="OnCloseCompleted"/>
                            <TextBlock Text="完结馆" FontSize="18" FontWeight="Bold" Margin="16,0,0,0"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CompletedSummary" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" Margin="14,2,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <RadioButton x:Name="CompletedGroupMonth" Style="{StaticResource Chip}" GroupName="cgmode"
                                         Content="按月份" IsChecked="True" Checked="OnCompletedModeChanged"
                                         Margin="0,0,6,0"/>
                            <RadioButton x:Name="CompletedGroupYear" Style="{StaticResource Chip}" GroupName="cgmode"
                                         Content="按年份" Checked="OnCompletedModeChanged"
                                         Margin="0,0,6,0"/>
                            <RadioButton x:Name="CompletedGroupAll" Style="{StaticResource Chip}" GroupName="cgmode"
                                         Content="全部" Checked="OnCompletedModeChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="CompletedHost" Margin="28,20,28,28"/>
                        <!-- 空状态 -->
                        <StackPanel x:Name="CompletedEmpty" Visibility="Collapsed" HorizontalAlignment="Center"
                                    VerticalAlignment="Top" Margin="0,90">
                            <Border Width="92" Height="92" CornerRadius="46" Background="{DynamicResource Panel2}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="🏆" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="还没有完结的游戏" FontSize="16" FontWeight="Bold" Margin="0,18,0,0"
                                       Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="在游戏详情页点「🏆 完结撒花」，通关的游戏就会带着完结日期收藏到这里。"
                                       FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,0"
                                       TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 回顾详情：点海报卡进入（不离开完结馆）。站在玩家角度回顾：
                     完结日/入库/总时长/次数/平均/近 7·30 天/备份/历次会话 -->
                <Border x:Name="CompletedDetail" Grid.Row="1" Background="{DynamicResource UuBackdropBrush}"
                        Visibility="Collapsed">
                    <Border.Resources>
                        <Style x:Key="SessionBadgeC" TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                            <Setter Property="Padding" Value="7,1.5"/>
                            <Setter Property="Background" Value="{DynamicResource BadgeLocalBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BadgeLocalBorder}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>
                        <Style x:Key="SessionBadgeTextC" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{DynamicResource Orange}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </Border.Resources>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 内嵌背景：与改动前一致——同款壁纸（UniformToFill）+ Veil 压暗；
                             详情层 UuBackdropBrush 为不透明渐变，整层盖住收藏墙，下层海报不会透出。
                             浅色 UuArtOpacity=0 隐藏壁纸，只见不透明浅色渐变 -->
                        <Grid Grid.RowSpan="2" Opacity="{DynamicResource UuArtOpacity}"
                              IsHitTestVisible="False" ClipToBounds="True">
                            <Image Source="/GameSaveVault;component/Assets/immersive_wallpaper.png"
                                   Stretch="UniformToFill"/>
                            <Border Background="{DynamicResource UuArtVeil}"/>
                        </Grid>
                        <!-- 沉浸辉光层（语义覆盖字典沿用父级 CompletedView 的 ImmersiveScope） -->
                        <Border Grid.RowSpan="2" Background="{DynamicResource UuGlowTealBrush}" IsHitTestVisible="False"/>
                        <Border Grid.RowSpan="2" Background="{DynamicResource UuGlowIndigoBrush}" IsHitTestVisible="False"/>
                        <Border Grid.Row="0" Background="{DynamicResource Panel}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,9">
                            <!-- 左右两列：右列按钮组空间不足时自动折行，窄窗/宽侧栏下不再裁掉「在列表中查看」 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnCompletedDetailBack" Style="{StaticResource Btn}"
                                            Content="← 收藏墙" Click="OnCompletedDetailBack"/>
                                    <TextBlock Text="完结回顾" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="16,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnCdRun" Style="{StaticResource BtnSm}" Content="▶ 运行游戏"
                                            Margin="0,0,8,4" Click="OnCompletedDetailRun"
                                            Visibility="{Binding Archived, Converter={StaticResource InverseBoolToVis}}"/>
                                    <Button x:Name="BtnCdChangePoster" Style="{StaticResource BtnSm}" Content="🖼 换海报"
                                            Margin="0,0,8,4" Click="OnCompletedDetailChangePoster"/>
                                    <Button x:Name="BtnCdEditDate" Style="{StaticResource BtnSm}" Content="📅 修改完结日期"
                                            Margin="0,0,8,4" Click="OnCompletedDetailEditDate"/>
                                    <Button x:Name="BtnCdUnmark" Style="{StaticResource BtnSm}" Content="✕ 取消完结"
                                            Margin="0,0,8,4" Click="OnCompletedDetailUnmark"
                                            Visibility="{Binding Archived, Converter={StaticResource InverseBoolToVis}}"/>
                                    <Button x:Name="BtnCdDeleteArchive" Style="{StaticResource BtnSm}" Content="🗑 彻底删除档案"
                                            Margin="0,0,8,4" Click="OnCompletedDetailDeleteArchive"
                                            Visibility="{Binding Archived, Converter={StaticResource BoolToVis}}"/>
                                    <Button x:Name="BtnCdLocate" Style="{StaticResource BtnSm}" Content="在列表中查看"
                                            Margin="0,0,0,4" Click="OnCompletedDetailLocate"
                                            Visibility="{Binding Archived, Converter={StaticResource InverseBoolToVis}}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="920" Margin="24,14,24,16"
                                        HorizontalAlignment="Stretch">
                                <!-- 头部：竖海报 + 名称/完结信息（紧凑：海报 104×156，单行元信息） -->
                                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="104" Height="156" CornerRadius="8"
                                                ClipToBounds="True" Background="{DynamicResource Panel2}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding PosterDisplayFile}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasPosterDisplay, Converter={StaticResource BoolToVis}}"/>
                                                <Border Visibility="{Binding HasPosterDisplay, Converter={StaticResource InverseBoolToVis}}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="{DynamicResource IconPlaceholderStart}" Offset="0"/>
                                                            <GradientStop Color="{DynamicResource IconPlaceholderEnd}" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Letter}" FontSize="40" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="21" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SubName}" FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{DynamicResource GreenSoft}"
                                                    BorderBrush="{DynamicResource GreenSoftBorder}"
                                                    BorderThickness="1" CornerRadius="13" Padding="10,4"
                                                    Margin="0,9,0,0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                                        <Path Stretch="Uniform" Data="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.41 5 9.31 5 8zm14 0c0 1.31-.84 2.41-2 2.82V7h2v1z">
                                                            <Path.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="{DynamicResource MemorialGoldHi}" Offset="0"/>
                                                                    <GradientStop Color="{DynamicResource MemorialGoldLo}" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Path.Fill>
                                                        </Path>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding CompletedFullText}" FontSize="12.5"
                                                               FontWeight="Bold" Foreground="{DynamicResource Green}"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock Text="入库 " FontSize="12"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="{Binding AddedAtText}" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="最后游玩 " FontSize="12" Margin="16,0,0,0"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="{Binding LastPlayedText}" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 右侧完结纪念卡：配色跟随三套主题（冷底衬暖金，金色只给日期主角） -->
                                        <Border Grid.Column="2" Width="200" Margin="14,0,0,0"
                                                CornerRadius="10" BorderThickness="1"
                                                BorderBrush="{DynamicResource MemorialBorder}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                                                    <GradientStop Color="{DynamicResource MemorialBgTop}" Offset="0"/>
                                                    <GradientStop Color="{DynamicResource MemorialBgBottom}" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid Margin="13,10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center"
                                                            Margin="0,3,0,0">
                                                    <!-- 手绘金杯：香槟金渐变（低饱和） -->
                                                    <Viewbox Width="15" Height="15" Margin="0,0,7,0">
                                                        <Path Data="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.41 5 9.31 5 8zm14 0c0 1.31-.84 2.41-2 2.82V7h2v1z">
                                                            <Path.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="{DynamicResource MemorialGoldHi}" Offset="0"/>
                                                                    <GradientStop Color="{DynamicResource MemorialGoldLo}" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Path.Fill>
                                                        </Path>
                                                    </Viewbox>
                                                    <TextBlock Text="完结纪念" FontSize="12.5" FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MemorialTitle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <!-- 唯一主角：完结日期，主题金渐变 -->
                                                    <TextBlock x:Name="CdMemorialDate" FontSize="23" FontWeight="Bold"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Foreground>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="{DynamicResource MemorialGoldHi}" Offset="0"/>
                                                                <GradientStop Color="{DynamicResource MemorialGoldLo}" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                    <TextBlock x:Name="CdMemorialAgo" FontSize="11.5"
                                                               Margin="0,5,0,0" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource MemorialMuted}"/>
                                                </StackPanel>
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="1"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                        <TextBlock Text="通关用时" FontSize="10.5"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource MemorialMuted}"/>
                                                        <TextBlock x:Name="CdMemorialSpan" FontSize="14" FontWeight="SemiBold"
                                                                   Margin="0,2,0,0" HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource MemorialValue}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource MemorialDivider}" Margin="0,3"/>
                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                        <TextBlock Text="完结至今" FontSize="10.5"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource MemorialMuted}"/>
                                                        <TextBlock x:Name="CdMemorialSince" FontSize="14" FontWeight="SemiBold"
                                                                   Margin="0,2,0,0" HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource MemorialSince}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 统计：单行 6 个紧凑指标格（总时长格用强调色底，视觉排序） -->
                                <UniformGrid Columns="6" Margin="0,10,0,0">
                                    <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}"
                                            BorderThickness="1" CornerRadius="8" Margin="0,0,4,0" Padding="10,7">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="总时长" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="{Binding TotalPlayText}" FontSize="15" FontWeight="SemiBold"
                                                       Margin="0,2,0,0" Foreground="{DynamicResource Accent}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Margin="4,0,4,0" Padding="10,7">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="游玩次数" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock x:Name="CdStatCount" FontSize="15" FontWeight="SemiBold"
                                                       Margin="0,2,0,0" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Margin="4,0,4,0" Padding="10,7">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="平均每次" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock x:Name="CdStatAverage" FontSize="15" FontWeight="SemiBold"
                                                       Margin="0,2,0,0" Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Margin="4,0,4,0" Padding="10,7">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="近 7 天" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock x:Name="CdStatWeek7" FontSize="15" FontWeight="SemiBold"
                                                       Margin="0,2,0,0" Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Margin="4,0,4,0" Padding="10,7">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="近 30 天" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock x:Name="CdStatWeek30" FontSize="15" FontWeight="SemiBold"
                                                       Margin="0,2,0,0" Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Margin="4,0,0,0" Padding="10,7">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="存档备份" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock x:Name="CdStatBackups" FontSize="15" FontWeight="SemiBold"
                                                       Margin="0,2,0,0" Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- 历次会话（紧凑：内部列表自带滚动，整页不再需要滚轮） -->
                                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Margin="0,10,0,0"
                                        MinHeight="120" MaxHeight="168">
                                    <Grid Margin="4,2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" x:Name="CdSessionHeader" FontSize="11.5"
                                                   Margin="10,5,0,3" Foreground="{DynamicResource TextSecondary}"/>
                                        <ListBox Grid.Row="1" x:Name="CdSessionList" BorderThickness="0"
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimary}">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="6,1.5"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                        CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background"
                                                                                Value="{DynamicResource AccentSoft}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding RangeText}" FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="12"
                                                                   Margin="0,0,10,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondary}"/>
                                                        <Border Grid.Column="2" Style="{StaticResource SessionBadgeC}"
                                                                Visibility="{Binding Interrupted, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Style="{StaticResource SessionBadgeTextC}" Text="中断"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    x:Name="CdSessionEmpty">
                                            <TextBlock Text="暂无游玩记录" FontSize="13" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="启动游戏玩一局，退出后自动记录" FontSize="11.5"
                                                       Margin="0,6,0,0" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="游玩数据仅统计本程序开启后的记录；完结日期可随时补改。"
                                           FontSize="10.5" Margin="2,7,0,0"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Popup x:Name="CompletedDatePopup" Placement="Bottom" AllowsTransparency="True"
               StaysOpen="False" PopupAnimation="Fade">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="选择完结日期（点日期即生效）" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,6"/>
                    <Calendar x:Name="CompletedCalendar" SelectedDatesChanged="OnCompletedDateChanged"/>
                    <Button x:Name="CompletedTodayBtn" Style="{StaticResource Btn}" Content="回到今天"
                            HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnCompletedTodayClick"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{DynamicResource ChromeBarBg}" BorderBrush="{DynamicResource ChromeBarBorder}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="StatusLeft" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusRight" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Toast -->
        <!-- 左下角：避开右侧详情区底部操作栏的常驻按钮（退出游戏时备份等） -->
        <Border x:Name="Toast" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Background="{DynamicResource ToastBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                CornerRadius="10" Padding="22,11" Margin="14,0,0,46" MaxWidth="340" Opacity="0"
                IsHitTestVisible="False" Panel.ZIndex="99">
            <TextBlock x:Name="ToastText" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource ToastText}"/>
        </Border>

        <!-- 锚定式提示：紧贴被点击控件的下方（操作栏开关反馈用），不遮挡按钮本身 -->
        <Popup x:Name="ToastPopup" Placement="Bottom" VerticalOffset="6"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border x:Name="ToastPopupCard" Background="{DynamicResource ToastBg}"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10"
                    Padding="18,10" MaxWidth="300" IsHitTestVisible="False">
                <TextBlock x:Name="ToastPopupText" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource ToastText}"/>
            </Border>
        </Popup>
    </Grid>

        <!-- 更新数据库的手动停止按钮（浮在右上角；RootGrid 禁用时仍可点） -->
        <Button x:Name="StopDbBtn" Style="{StaticResource BtnDanger}" Content="■ 停止更新"
                Padding="18,8" FontSize="13" Cursor="Hand"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,7,16,0" Visibility="Collapsed" Click="OnStopDbUpdate"/>
    </Grid>
</Window>
