<Window x:Class="GameSaveManager.PlayStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="游玩详情 · GameSaveVault"
        Icon="Assets/app.ico"
        Width="480" Height="640" MinHeight="560" MinWidth="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Panel}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- 「中断」徽章：本窗口本地样式（MainWindow 的 Badge 是窗口级资源，弹窗访问不到，
             StaticResource 缺失会在 Measure 周期反复抛异常导致栈溢出崩溃） -->
        <Style x:Key="SessionBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,1.5"/>
            <Setter Property="Background" Value="{DynamicResource BadgeLocalBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeLocalBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SessionBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Orange}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部：游戏名 + 类型 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Sub}" FontSize="11.5" Margin="0,3,0,0"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <!-- 统计卡片：2 列 3 行 -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,14,0,0">
            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="0,0,5,5" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="导入日期" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding Added}" FontSize="14" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="5,0,0,5" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="最后关闭" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding LastClose}" FontSize="14" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding LastCloseHint}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                               Visibility="{Binding LastCloseHintVisible}"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="0,5,5,5" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="游玩总时长" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding Total}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="5,5,0,5" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="平均每次 · 游玩次数" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding Average}" FontSize="14" MaxWidth="110"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Count}" FontSize="12" Margin="8,2,0,0"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="0,5,5,0" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="近 7 天" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding Week7}" FontSize="14" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="5,5,0,0" Padding="12,9">
                <StackPanel>
                    <TextBlock Text="近 30 天" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="{Binding Week30}" FontSize="14" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 游玩记录 -->
        <Border Grid.Row="2" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Margin="0,12,0,0">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding CountHeader}" FontSize="12" Margin="10,8,0,6"
                           Foreground="{DynamicResource TextSecondary}"/>
                <ListBox Grid.Row="1" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextPrimary}"
                         ItemsSource="{Binding Sessions}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="6,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding RangeText}" FontSize="12.5"
                                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="12.5"
                                           Margin="0,0,10,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <Border Grid.Column="2" Style="{StaticResource SessionBadge}"
                                        Visibility="{Binding Interrupted, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource SessionBadgeText}" Text="中断"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- 无记录空态 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding EmptyHintVisible}">
                    <TextBlock Text="暂无游玩记录" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock Text="启动游戏玩一局，退出后自动记录" FontSize="11.5"
                               Margin="0,6,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部：口径提示在左、关闭按钮在右，分列布局互不重叠 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="游玩数据仅统计本程序开启后的数据。"
                       FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextSecondary}"/>
            <Button Grid.Column="1" Content="关闭" Style="{StaticResource BtnSm}" Width="84"
                    Margin="12,0,0,0" Click="OnClose" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
