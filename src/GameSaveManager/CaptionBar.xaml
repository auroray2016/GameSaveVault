<UserControl x:Class="GameSaveManager.CaptionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32"
             Background="{DynamicResource Panel}"
             BorderBrush="{DynamicResource BorderBrush}"
             BorderThickness="0,0,0,1"
             Focusable="False"
             UseLayoutRounding="True">
    <!-- 子窗口通用自绘标题栏：与主窗口同款 32px WindowChrome（直角、Segoe MDL2 字形三键）。
         背景=Panel 与窗口内容同色一体，底边 1px 极淡分隔线；三键行为/字形切换/最大化补偿
         全部在 CaptionBar.xaml.cs 内按宿主窗口 ResizeMode 自动适配。 -->
    <Grid>
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Image x:Name="WinIcon" Width="15" Height="15" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="WinTitle" FontSize="12" Margin="9,1,0,0"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
        </StackPanel>
        <!-- 右起：关闭/最大化/最小化；NoResize 窗口在 code-behind 隐藏前两颗 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="BtnMin" Style="{StaticResource CaptionBtn}" Click="OnMinimize"
                    ToolTip="最小化" Content="&#xE921;"/>
            <Button x:Name="BtnMax" Style="{StaticResource CaptionBtn}" Click="OnToggleMax"
                    ToolTip="最大化">
                <TextBlock x:Name="GlyphMax" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
            </Button>
            <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseBtn}" Click="OnClose"
                    ToolTip="关闭" Content="&#xE8BB;"/>
        </StackPanel>
    </Grid>
</UserControl>
