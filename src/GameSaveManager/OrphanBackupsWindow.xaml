<Window x:Class="GameSaveManager.OrphanBackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GameSaveManager"
        Title="未关联备份 · GameSaveVault"
        Icon="Assets/app.ico"
        Width="760" Height="540" MinHeight="440" MinWidth="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Panel}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:CaptionBar Grid.Row="0"/>
        <Grid Grid.Row="1" Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 备份根目录 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="备份存放目录" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,0,12,0"/>
            <TextBox x:Name="RootBox" Grid.Column="1" Height="30" IsReadOnly="True"
                     VerticalContentAlignment="Center" FontSize="12" FontFamily="Consolas"
                     Background="{DynamicResource Panel2}" Foreground="{DynamicResource TextPrimary}"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
            <Button Grid.Column="2" Style="{StaticResource BtnSm}" Content="在资源管理器打开"
                    Click="OnOpenRoot" Margin="10,0,0,0"/>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="SummaryText" Margin="2,12,0,8" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>

        <Border Grid.Row="2" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10">
            <Grid Margin="4">
                <ListView x:Name="OrphanList" BorderThickness="0" Background="Transparent"
                          Foreground="{DynamicResource TextPrimary}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="OnOrphanListSizeChanged">
                    <ListView.Resources>
                        <!-- 重写 ListViewItem 模板：GridViewRowPresenter 正确承载 GridView 列（不能用 ContentPresenter），
                             选中底色用 RowSelectedBg，比界面底色更深形成反色对比。 -->
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                SnapsToDevicePixels="True">
                                            <!-- GridViewRowPresenter：WPF 内置，专门用来正确渲染 GridView 的每一列 -->
                                            <GridViewRowPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedBg}"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True"/>
                                                    <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowSelectedHoverBg}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- 列头背景 -->
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource Panel2}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <!-- 首列弹性：宽度由 OnOrphanListSizeChanged 按列表实际宽分配，其余四列固定，窄窗不再裁掉操作按钮 -->
                            <GridViewColumn x:Name="ColName" Header="名称" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="2,3">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TypeText}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="内容" Width="104">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DetailText}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="占用" Width="72">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="最近文件" Width="92">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastWriteText}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="操作" Width="104">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="2,3">
                                            <Button Style="{StaticResource BtnSm}" Content="打开"
                                                    Tag="{Binding}" Click="OnOpenItem"/>
                                            <Button Style="{StaticResource BtnSm}" Content="删除"
                                                    Tag="{Binding}" Click="OnDeleteItem" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="🗂" FontSize="40" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="没有未关联备份" FontSize="14"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,0"/>
                    <TextBlock Text="磁盘上的备份都属于在库游戏" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="移除游戏时选择「保留」的备份与玩家档案会列在这里；重新添加同名游戏后自动找回。删除操作不可恢复。"
                       FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn}" Content="刷新" Width="80" Click="OnRefresh"/>
                <Button Style="{StaticResource BtnPrimary}" Content="关闭" Width="80" Margin="10,0,0,0"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</Window>
